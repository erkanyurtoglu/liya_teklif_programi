<Window x:Class="teklif_programi.view.SatisSozlesmesiWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Satış Sözleşmesi" Height="600" Width="800"
        WindowStartupLocation="CenterScreen">
    <Grid Background="#f8f8f8" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- RichTextBox ile düzenlenebilir sözleşme alanı -->
        <RichTextBox x:Name="SatisSozlesmesiBox" Grid.Row="0" Margin="0,0,0,10" FontSize="14" FontFamily="Segoe UI" AcceptsReturn="True"/>

        <Button Content="Kapat" Width="100" Height="35" HorizontalAlignment="Right" Grid.Row="1" Click="Kapat_Click"/>
    </Grid>
</Window>