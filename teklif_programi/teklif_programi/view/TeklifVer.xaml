<UserControl x:Class="teklif_programi.view.TeklifVer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1350">

    <UserControl.Resources>
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="#13183E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Source Sans Pro"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#4B4B4B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="SepeteEkleTemplate">
            <Button Content="Seç" 
                    Style="{StaticResource ModernButtonStyle}" 
                    Width="50" Height="30"
                    Background="#2980B9" 
                    Click="BtnSepeteEkle_Click"/>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="#ededed" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto" MinHeight="78.96"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,30" Width="360">
            <TextBlock Text="📝 Müşteriye Teklif Ver"
                       FontSize="32" FontWeight="Bold"
                       FontFamily="Segoe UI" Foreground="#13183E"
                       TextAlignment="Center"/>
            <Border Height="2" Width="360" Background="#13183E" CornerRadius="1" Margin="0,8,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="431*"/>
                <ColumnDefinition Width="879*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="10,0,20,0">
                <TextBlock FontWeight="SemiBold" Foreground="#13183E" Margin="0,0,0,5">
                    <Run Text="Firma Kodu"/><Run Language="tr-tr" Text=" veya Firma Adı"/>
                </TextBlock>
                <TextBox x:Name="txtFirmaKodu" Height="38" FontSize="14" Padding="5"
                         BorderBrush="#ccc" BorderThickness="1" Background="White"
                         TextChanged="txtFirmaKodu_TextChanged"
                         VerticalContentAlignment="Center"/>
            </StackPanel>

            <Grid Grid.Column="1" Margin="10,0,20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="354*"/>
                    <ColumnDefinition Width="165*"/>
                    <ColumnDefinition Width="165*"/>
                    <ColumnDefinition Width="174*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Firma Adı" FontWeight="SemiBold" Foreground="#13183E" Margin="0,0,0,5"/>
                    <TextBlock x:Name="lblFirmaAdi" Text="-" FontSize="14" Foreground="#7F8C8D" Margin="0,10,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Center" Width="96">
                    <TextBlock Text="Genel İndirim (%)" FontWeight="SemiBold" Foreground="#13183E" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtGenelIndirim"
                             Width="60" Height="30"
                             FontSize="14" FontWeight="SemiBold"
                             HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                             Background="White" Foreground="#13183E"
                             BorderBrush="#13183E" BorderThickness="1"
                             Padding="2" Cursor="IBeam"
                             PreviewTextInput="GenelIndirimTextBox_PreviewTextInput"
                             TextChanged="txtGenelIndirim_TextChanged"/>
                </StackPanel>

                <StackPanel Grid.Column="2" HorizontalAlignment="Center" Width="96">
                    <TextBlock Text="KDV" FontWeight="SemiBold" Foreground="#13183E" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                    <TextBox x:Name="txtKDV"
                             Width="60" Height="30"
                             FontSize="14" FontWeight="SemiBold"
                             HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                             Background="White" Foreground="#13183E"
                             BorderBrush="#13183E" BorderThickness="1"
                             Padding="2" Cursor="IBeam"
                             PreviewTextInput="KDVTextBox_PreviewTextInput"
                             TextChanged="KDV_TextChanged"/>
                </StackPanel>

                <StackPanel Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center" Width="96">
                    <ComboBox x:Name="cmbParaBirimi" Width="80" Height="30" FontSize="14"
                             SelectedIndex="2" SelectionChanged="cmbParaBirimi_SelectionChanged">
                        <ComboBoxItem>USD</ComboBoxItem>
                        <ComboBoxItem>EUR</ComboBoxItem>
                        <ComboBoxItem>TRY</ComboBoxItem>
                    </ComboBox>
                </StackPanel>

            </Grid>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="421*"/>
                <ColumnDefinition Width="889*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="10,0,10,10">
                <TextBlock Text="Ürün Filtrele" FontWeight="SemiBold" Foreground="#13183E" Margin="0,0,0,5"/>
                <TextBox x:Name="txtUrunFiltrele" Height="44" FontSize="14" Padding="5" 
                         BorderBrush="#ccc" BorderThickness="1" Background="White" 
                         TextChanged="txtUrunFiltrele_TextChanged"
                         VerticalContentAlignment="Center"/>
            </StackPanel>

            <DataGrid x:Name="dataGridUrunListesi"
                      Grid.Column="0" Margin="10,90,10,10"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column"
                      CanUserAddRows="False"
                      GridLinesVisibility="None"
                      RowHeight="40" ColumnHeaderHeight="45"
                      AlternatingRowBackground="#ededed"
                      FontFamily="Segoe UI" FontSize="13"
                      BorderBrush="#ededed" BorderThickness="1" 
                      SelectionChanged="dataGridUrunListesi_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Ürün Kodu" Binding="{Binding UrunKoduID}" Width="1*"/>
                    <DataGridTextColumn Header="Açıklama" Binding="{Binding Aciklama}" Width="1.5*"/>
                    <DataGridTemplateColumn Header="İşlem" Width="70" CellTemplate="{StaticResource SepeteEkleTemplate}"/>
                </DataGrid.Columns>
            </DataGrid>

            <DataGrid x:Name="dataGridUrunSepeti"
                      Grid.Column="1" Margin="10,19,10,10"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column"
                      RowHeight="40" ColumnHeaderHeight="45"
                      AlternatingRowBackground="#ededed"
                      FontFamily="Segoe UI" FontSize="13"
                      CanUserAddRows="False"
                      GridLinesVisibility="None"
                      BorderBrush="#ededed" BorderThickness="1" SelectionChanged="dataGridUrunSepeti_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Ürün Kodu" Binding="{Binding UrunKoduID}" Width="1.2*"/>
                    <DataGridTextColumn Header="Açıklama" Binding="{Binding Aciklama}" Width="2*"/>
                    <DataGridTemplateColumn Header="Adet" Width="1.2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding Adet, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                 Width="60" Height="30"
                                 FontSize="14" FontWeight="SemiBold"
                                 HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                 Background="White" Foreground="#13183E"
                                 BorderBrush="#13183E" BorderThickness="1"
                                 Padding="2"
                                 Cursor="IBeam"
                                 PreviewTextInput="AdetTextBox_PreviewTextInput"
                                 LostFocus="AdetTextBox_LostFocus" 
                                    Margin="0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Birim Satış Fiyatı" Binding="{Binding BirimSatisFiyati, StringFormat=C2}" Width="1.6*"/>
                    <DataGridTextColumn Header="İndirimli Birim Satış Fiyatı" Binding="{Binding IndirimliToplamFiyat, StringFormat=C2}" Width="2.4*"/>
                    <DataGridTextColumn Header="Satış Fiyatı" Binding="{Binding ToplamSatisFiyati, StringFormat=C2}" Width="1.2*"/>
                    <DataGridTextColumn Header="Yurtiçi Maliyet" Binding="{Binding YurticiMaliyet, StringFormat=C2}" Width="1.5*"/>
                    <DataGridTemplateColumn Header="İşlemler" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Sil" Style="{StaticResource ModernButtonStyle}" Width="70" Height="30" Background="#C0392B" Click="BtnUrunSil_Click"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <StackPanel Grid.Row="3" HorizontalAlignment="Right" Margin="0,10,20,10" Orientation="Horizontal">
            <TextBlock Text="Toplam:" FontWeight="Bold" FontSize="14" Foreground="#13183E" Margin="0,0,10,0"/>
            <TextBlock x:Name="lblToplam" Text="{Binding ToplamTutar, StringFormat=C2}" FontWeight="Bold" FontSize="14" Foreground="#13183E" Margin="0,0,20,0"/>
            <TextBlock Text="KDV:" FontWeight="Bold" FontSize="14" Foreground="#13183E" Margin="0,0,10,0"/>
            <TextBlock x:Name="lblKDV" Text="{Binding KdvTutar, StringFormat=C2}" FontWeight="Bold" FontSize="14" Foreground="#13183E" Margin="0,0,20,0"/>
            <TextBlock Text="Genel Toplam:" FontWeight="Bold" FontSize="14" Foreground="#13183E" Margin="0,0,10,0"/>
            <TextBlock x:Name="lblGenelToplam" Text="{Binding GenelToplam, StringFormat=C2}" FontWeight="Bold" FontSize="14" Foreground="#13183E"/>
        </StackPanel>

        <StackPanel Grid.Row="4" HorizontalAlignment="Center" Margin="0,20,0,10" Width="320">
            <Button Content="Teklif Oluştur ve PDF İndir" Width="320" Height="38" Style="{StaticResource ModernButtonStyle}" Click="BtnTeklifOlusturVePdfIndir_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
