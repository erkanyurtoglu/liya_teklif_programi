<Window x:Class="teklif_programi.view.anaEkran"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:teklif_programi.view"
        mc:Ignorable="d"
        Title="Liya Laboratuvar A.Ş. Teklif Sistemi" Height="900" Width="1600"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize" WindowState="Maximized"
        Background="#ededed">

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Navigation Menu -->
            <ColumnDefinition Width="250" />
            <!-- Content section -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Navigation Menu -->
        <Border Grid.Column="0">
            <Border.Background>
                <SolidColorBrush Color="#13183E" />
            </Border.Background>

            <StackPanel>
                <!-- Logo -->
                <StackPanel>
                    <Image Source="/resimler/liya_logo.png" Width="200" Height="100" HorizontalAlignment="Center" Margin="15" />
                </StackPanel>

                <!-- Menü Butonları -->
                <Button Click="btnFirmalarim_Click" Style="{StaticResource NavigationButtonBaseStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🏢" FontFamily="{StaticResource FontAwesome}" FontSize="18" VerticalAlignment="Center" Margin="10,0,40,0"/>
                        <TextBlock Text="Firmalarım" VerticalAlignment="Center" Margin="5,0"/>
                    </StackPanel>
                </Button>
                <Button Click="btnFirmaEkle_Click" Style="{StaticResource NavigationButtonBaseStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🏢⁺" FontFamily="{StaticResource FontAwesome}" FontSize="18" VerticalAlignment="Center" Margin="10,0,35,0"/>
                        <TextBlock Text="Firma Ekle" VerticalAlignment="Center" Margin="5,0"/>
                    </StackPanel>
                </Button>
                <Button Click="btnUrunlerim_Click" Style="{StaticResource NavigationButtonBaseStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📋" FontFamily="{StaticResource FontAwesome}" FontSize="18" VerticalAlignment="Center" Margin="10,0,43,0"/>
                        <TextBlock Text="Ürünlerim" VerticalAlignment="Center" Margin="5,0"/>
                    </StackPanel>
                </Button>
                <Button Click="btnUrunEkle_Click" Style="{StaticResource NavigationButtonBaseStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📋⁺" FontFamily="{StaticResource FontAwesome}" FontSize="18" VerticalAlignment="Center" Margin="10,0,38,0"/>
                        <TextBlock Text="Ürün Ekle" VerticalAlignment="Center" Margin="5,0"/>
                    </StackPanel>
                </Button>
                <Button Click="btnPersonellerim_Click" Style="{StaticResource NavigationButtonBaseStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="👤" FontFamily="{StaticResource FontAwesome}" FontSize="18" VerticalAlignment="Center" Margin="10,0,30,0"/>
                        <TextBlock Text="Personellerim" VerticalAlignment="Center" Margin="5,0"/>
                    </StackPanel>
                </Button>
                <Button Click="btnPersonelEkle_Click" Style="{StaticResource NavigationButtonBaseStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="👤⁺" FontFamily="{StaticResource FontAwesome}" FontSize="18" VerticalAlignment="Center" Margin="10,0,25,0"/>
                        <TextBlock Text="Personel Ekle" VerticalAlignment="Center" Margin="5,0"/>
                    </StackPanel>
                </Button>
                <Button Click="btnTeklifVer_Click" Style="{StaticResource NavigationButtonBaseStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📨" FontFamily="{StaticResource FontAwesome}" FontSize="18" VerticalAlignment="Center" Margin="10,0,47,0"/>
                        <TextBlock Text="Teklif Ver" VerticalAlignment="Center" Margin="5,0"/>
                    </StackPanel>
                </Button>
                <Button Click="btnGecmisTekliflerim_Click" Style="{StaticResource NavigationButtonBaseStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⏳" FontFamily="{StaticResource FontAwesome}" FontSize="18" VerticalAlignment="Center" Margin="10,0,15,0"/>
                        <TextBlock Text="Geçmiş Tekliflerim" VerticalAlignment="Center" Margin="5,0"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- Content section -->
        <Grid Grid.Column="1" Background="White" />
    </Grid>
</Window>