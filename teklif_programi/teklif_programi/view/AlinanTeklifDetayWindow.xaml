<Window x:Class="teklif_programi.view.AlinanTeklifDetayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:teklif_programi"
        mc:Ignorable="d"
        Title="Alınan Teklif Detayları"
        Width="1500" Height="800"
        MinWidth="1400" MinHeight="700"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        WindowStartupLocation="CenterScreen"
        Background="#ededed">
    <Window.Resources>
        <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>

        <!-- Modern Button -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="#13183E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Source Sans Pro"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="4"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#4B4B4B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Red Button -->
        <Style x:Key="RedButton" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="#C0392B"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="4" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#A93226"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern TextBox -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#ccc"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="IsReadOnly" Value="True"/>
        </Style>

        <!-- Modern DataGrid -->
        <Style x:Key="ModernDataGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#ededed"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F9FAFB"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeight" Value="40"/>
            <Setter Property="ColumnHeaderHeight" Value="45"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="IsReadOnly" Value="True"/>
        </Style>    

        <Style x:Key="DataGridColumnHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#13183E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Başlık -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="📝 Teklif Detayları"
                       FontSize="32" FontWeight="Bold" Foreground="#13183E"
                       HorizontalAlignment="Center" Margin="0,0,0,5"/>
            <Border Height="2" Width="410" Background="#13183E" HorizontalAlignment="Center" CornerRadius="1"/>
        </StackPanel>

        <!-- Üst Bilgiler -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="184*"/>
                <RowDefinition Height="33*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="480*"/>
                <ColumnDefinition Width="427*"/>
                <ColumnDefinition Width="269"/>
                <ColumnDefinition Width="284"/>
            </Grid.ColumnDefinitions>

            <!-- Firma -->
            <Border Grid.Column="0" Background="White" CornerRadius="4" Padding="15" Margin="0,0,10,21" BorderBrush="#ededed" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,10">
                        <TextBlock Text="Firma Adı" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,5" Foreground="#13183E"/>
                        <TextBox Style="{StaticResource ModernTextBox}" IsReadOnly="True" Text="{Binding Teklif.Musteri.FirmaAdi}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                        <TextBlock Text="Firma E-Posta" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,5" Foreground="#13183E"/>
                        <TextBox Style="{StaticResource ModernTextBox}" IsReadOnly="True" Text="{Binding Teklif.Musteri.FirmaEposta}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,10">
                        <TextBlock Text="İlgili Kişi" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,5" Foreground="#13183E"/>
                        <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding Teklif.IlgiliKisi, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,10">
                        <TextBlock Text="İlgili Kişi Numarası" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,5" Foreground="#13183E"/>
                        <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding Teklif.IlgiliKisiTelefonu, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>


                </Grid>
            </Border>

            <!-- Sağ: Para Birimi, İndirim/KDV & Durum -->
            <Border Grid.Column="1" Background="White" CornerRadius="4" BorderBrush="#ededed" BorderThickness="1" Margin="0,0,3,21" Padding="0,10">
                <StackPanel Margin="0,0,0,10" >

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="20,0,0,10">
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="İndirim (%)" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,5" Foreground="#13183E"/>
                            <TextBox Style="{StaticResource ModernTextBox}" Width="87"
                                     Text="{Binding GenelIndirimOrani, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=F0}"
                                     PreviewTextInput="OnlyAllowNumbers"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="KDV (%)" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,5" Foreground="#13183E"/>
                            <TextBox Style="{StaticResource ModernTextBox}" Width="88"
                                     Text="{Binding KdvOrani, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=F0}"
                                     PreviewTextInput="OnlyAllowNumbers"/>
                        </StackPanel>
                        <StackPanel Margin="10,0">
                            <TextBlock Text="Paketleme" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,5" Foreground="#13183E"/>
                            <TextBox Style="{StaticResource ModernTextBox}" Width="88"
                                     Text="{Binding PaketlemeUcret, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=F0}"
                                     PreviewTextInput="OnlyAllowNumbers"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Taşıma Ücreti" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,5" Foreground="#13183E"/>
                            <TextBox Style="{StaticResource ModernTextBox}" Width="88"
                                     Text="{Binding TasimaUcret, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=F0}"
                                     PreviewTextInput="OnlyAllowNumbers"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="20,0,0,10">
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Durum" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,5" Foreground="#13183E"/>
                            <ComboBox ItemsSource="{Binding Durumlar}"
                                      SelectedItem="{Binding Teklif.Durum, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Width="120" Height="35" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                      IsEnabled="True"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Dil" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,5" Foreground="#13183E"/>
                            <ComboBox ItemsSource="{Binding DilListe}"
                                      SelectedItem="{Binding SelectedLanguage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Width="120" Height="35" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                      IsEnabled="False"/>
                        </StackPanel>

                        <StackPanel Width="121">
                            <TextBlock Text="Para Birimi" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,5" Foreground="#13183E"/>
                            <ComboBox ItemsSource="{Binding ParaBirimiListe}"
                                      SelectedItem="{Binding SelectedCurrency, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Width="120" Height="35" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                      IsEnabled="False"/>
                        </StackPanel>
                    </StackPanel>

                </StackPanel>
            </Border>

            <!-- Teslimat Bilgisi -->
            <Border Grid.Column="2" Background="White" CornerRadius="4" Padding="10" Margin="9,0,0,20" BorderBrush="#ededed" BorderThickness="1">
                <StackPanel>

                    <!-- Teslimat Şekli -->
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="Teslimat Şekli:" 
                       FontWeight="SemiBold" FontSize="13" Foreground="#13183E" Margin="0,0,0,5"/>
                        <TextBox Style="{StaticResource ModernTextBox}"
                     Text="{Binding TeslimatSekli, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True" TextWrapping="Wrap" Height="35"
                     ToolTip="Örn: Kara yolu, Hava yolu, Deniz yolu"/>
                    </StackPanel>

                    <!-- Teslimat Yeri -->
                    <StackPanel>
                        <TextBlock Text="Teslimat Yeri:" 
                       FontWeight="SemiBold" FontSize="13" Foreground="#13183E" Margin="0,0,0,5"/>
                        <TextBox Style="{StaticResource ModernTextBox}"
                     Text="{Binding TeslimatYeri, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True" TextWrapping="Wrap" Height="39"
                     ToolTip="Örn: Demirexport fabrikasına teslimat"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Column="3" Background="White" CornerRadius="4" Padding="15"
        BorderBrush="#ededed" BorderThickness="1" Margin="9,0,0,20">
                <StackPanel>
                    <TextBlock Text="Müşteri Notu" FontWeight="SemiBold" FontSize="14"
                   Margin="0,0,0,5" Foreground="#13183E"/>
                    <TextBox Style="{StaticResource ModernTextBox}" Height="48"
                 AcceptsReturn="True" TextWrapping="Wrap"
                 Text="{Binding Teklif.MusteriNotu, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextChanged="TextBox_TextChanged"/>

                    <TextBlock Text="Teklifi Veren Personel" FontWeight="SemiBold" FontSize="14"
                   Margin="0,10,0,5" Foreground="#13183E"/>
                    <TextBox Style="{StaticResource ModernTextBox}" Height="38"
                     IsReadOnly="True"
                     Text="{Binding PersonelAdiSoyadi, Mode=OneWay}"/>

                </StackPanel>


            </Border>

        </Grid>

        <!-- Ürünler + Sepet -->
        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.7*"/>
            </Grid.ColumnDefinitions>

            <!-- Sepet -->
            <Border Grid.Column="0" Background="White" CornerRadius="4" Padding="15" BorderBrush="#ededed" BorderThickness="1" Margin="0,-24,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Teklif Listem" FontWeight="SemiBold" FontSize="14" Foreground="#13183E" Margin="0,0,0,10"/>

                    <DataGrid Grid.Row="1" Style="{StaticResource ModernDataGrid}" ItemsSource="{Binding TeklifUrunler}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Kod" Binding="{Binding UrunKodu}" Width="1.1*" HeaderStyle="{StaticResource DataGridColumnHeader}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Açıklama" Binding="{Binding UrunAciklamasi}" Width="1.8*" HeaderStyle="{StaticResource DataGridColumnHeader}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Adet" Binding="{Binding Adet, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="0.8*" HeaderStyle="{StaticResource DataGridColumnHeader}"/>
                            <DataGridTextColumn Header="Birim Fiyat" Binding="{Binding BirimFiyatText}" Width="1.1*" HeaderStyle="{StaticResource DataGridColumnHeader}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="İndirimli Fiyat" Binding="{Binding IndirimliFiyatText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="1.1*" HeaderStyle="{StaticResource DataGridColumnHeader}"/>
                            <DataGridTextColumn Header="Toplam" Binding="{Binding ToplamText}" Width="1.1*" HeaderStyle="{StaticResource DataGridColumnHeader}" IsReadOnly="True"/>
                            <DataGridTemplateColumn Header="Tamamlandı" Width="0.8*" HeaderStyle="{StaticResource DataGridColumnHeader}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Tamamlandi, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Not" Width="1.4*" HeaderStyle="{StaticResource DataGridColumnHeader}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Style="{StaticResource ModernTextBox}" IsReadOnly="False" Text="{Binding UretimNotu, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- Alt toplam & butonlar -->
        <Grid Grid.Row="3" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="4" Padding="15" BorderBrush="#ededed" BorderThickness="1">
                <Grid HorizontalAlignment="Right">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="0" Margin="10,5" HorizontalAlignment="Center">
                        <TextBlock Text="Toplam Maliyet: " FontWeight="SemiBold" FontSize="14" Foreground="#13183E"/>
                        <TextBlock Text="{Binding ToplamMaliyetText}" FontSize="14" Margin="5,0,0,0" Foreground="#13183E"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="1" Margin="10,5" HorizontalAlignment="Center">
                        <TextBlock Text="Kar Tutarı: " FontWeight="SemiBold" FontSize="14" Foreground="#13183E"/>
                        <TextBlock Text="{Binding KarTutariText}" FontSize="14" Margin="5,0,0,0" Foreground="#13183E"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="2" Margin="10,5" HorizontalAlignment="Center">
                        <TextBlock Text="Kar Oranı: " FontWeight="SemiBold" FontSize="14" Foreground="#13183E"/>
                        <TextBlock Text="{Binding KarOraniText}" FontSize="14" Margin="5,0,0,0" Foreground="#13183E"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="0" Margin="10,5" HorizontalAlignment="Center">
                        <TextBlock Text="Toplam Fiyat: " FontWeight="SemiBold" FontSize="14" Foreground="#13183E"/>
                        <TextBlock Text="{Binding IndirimliToplamText}" FontSize="14" Margin="5,0,0,0" Foreground="#13183E"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="1" Margin="10,5" HorizontalAlignment="Center">
                        <TextBlock Text="KDV Tutarı: " FontWeight="SemiBold" FontSize="14" Foreground="#13183E"/>
                        <TextBlock Text="{Binding KdvTutariText}" FontSize="14" Margin="5,0,0,0" Foreground="#13183E"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="2" Margin="10,5" HorizontalAlignment="Center">
                        <TextBlock Text="Genel Toplam: " FontWeight="SemiBold" FontSize="14" Foreground="#13183E"/>
                        <TextBlock Text="{Binding GenelToplamText}" FontSize="14" Margin="5,0,0,0" Foreground="#13183E"/>
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10,0,0,0">
                <Button Content="Kaydet" Style="{StaticResource ModernButtonStyle}" Width="120" Margin="0,0,10,0" Command="{Binding KaydetCommand}"/>
                <Button Content="Satış Sözleşmesi" Style="{StaticResource ModernButtonStyle}" Width="150" Margin="0,0,10,0" Click="SatisSozlesmesi_Click"/>
                <Button Content="Üretim Listesi İndir" Style="{StaticResource ModernButtonStyle}" Width="170" Margin="0,0,10,0" Command="{Binding UretimListesiIndirCommand}"/>
                <Button Content="PDF İndir" Style="{StaticResource ModernButtonStyle}" Width="120" Margin="0,0,10,0" Command="{Binding PdfIndirCommand}"/>

            </StackPanel>
        </Grid>
    </Grid>
</Window>   