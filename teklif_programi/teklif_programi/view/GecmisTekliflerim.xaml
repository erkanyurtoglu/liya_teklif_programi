<UserControl x:Class="teklif_programi.view.GecmisTekliflerim"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:teklif_programi"
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="1350">

    <UserControl.Resources>
        <!-- Modern Button Style -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="#13183E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Source Sans Pro"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#4B4B4B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="#ededed" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Başlık -->
            <RowDefinition Height="Auto"/>
            <!-- Arama -->
            <RowDefinition Height="*"/>
            <!-- Liste -->
            <RowDefinition Height="Auto"/>
            <!-- Alt Butonlar (opsiyonel, şu an kullanılmıyor) -->
        </Grid.RowDefinitions>

        <!-- Başlık ve Alt Çizgi -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="📜 Geçmiş Teklifler" 
                       FontSize="32" 
                       FontWeight="Bold"
                       FontFamily="Segoe UI"
                       Foreground="#13183E" 
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,5"/>
            <Border Height="2" 
                    Width="350"
                    Background="#13183E" 
                    HorizontalAlignment="Center" 
                    CornerRadius="1"/>
        </StackPanel>

        <!-- Arama Kutusu -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
            <TextBox x:Name="txtArama" 
                     Width="400" 
                     Height="38" 
                     FontSize="14" 
                     Padding="10,0"
                     VerticalContentAlignment="Center" 
                     BorderBrush="#ccc" 
                     BorderThickness="1"
                     Background="White" 
                     Foreground="Black" 
                     Text="{Binding TeklifArama, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>

        <!-- Teklif Listesi -->
        <DataGrid x:Name="dataGridTeklifler" 
                  Grid.Row="2" 
                  AutoGenerateColumns="False" 
                  HeadersVisibility="Column" 
                  IsReadOnly="True" 
                  Margin="0,0,0,20" 
                  RowHeight="40" 
                  ColumnHeaderHeight="45"
                  CanUserAddRows="False" 
                  FontFamily="Segoe UI" 
                  FontSize="13"
                  AlternatingRowBackground="#ededed" 
                  GridLinesVisibility="None"
                  BorderBrush="#ededed" 
                  BorderThickness="1"
                  ItemsSource="{Binding FiltrelenmisTeklifler}" 
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Teklif ID" 
                                   Binding="{Binding TeklifId}" 
                                   Width="0.7*"/>
                <DataGridTextColumn Header="Firma Adı" 
                                   Binding="{Binding Musteri.FirmaAdi}" 
                                   Width="2*"/>
                <DataGridTextColumn Header="Tarih" 
                                   Binding="{Binding OlusturmaTarihi, StringFormat=dd.MM.yyyy}" 
                                   Width="1*"/>
                <DataGridTextColumn Header="Durum" 
                                   Binding="{Binding Durum}" 
                                   Width="1*"/>
                <DataGridTemplateColumn Header="İşlemler" 
                                       Width="170">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="Detay" 
                                        Style="{StaticResource ModernButtonStyle}" 
                                        Width="70" 
                                        Height="30" 
                                        Margin="4,0" 
                                        Command="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=DataContext.DetayGosterCommand}" 
                                        CommandParameter="{Binding}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>