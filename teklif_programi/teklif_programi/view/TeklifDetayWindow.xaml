<Window x:Class="teklif_programi.view.TeklifDetayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:teklif_programi"
        mc:Ignorable="d" 
        d:DesignWidth="1100" d:DesignHeight="800" 
        Width="1100" Height="800"
        WindowStartupLocation="CenterScreen"
        Background="#ededed">
    <Window.Resources>
        <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="#13183E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Source Sans Pro"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#4B4B4B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#ccc"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ModernDataGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#ededed"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F9FAFB"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeight" Value="48"/>
            <Setter Property="ColumnHeaderHeight" Value="50"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style x:Key="DataGridColumnHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#13183E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="📑 Teklif Detayları" FontSize="32" FontWeight="Bold" FontFamily="Segoe UI" Foreground="#13183E" HorizontalAlignment="Center" Margin="0,0,0,5"/>
            <Border Height="2" Width="350" Background="#13183E" HorizontalAlignment="Center" CornerRadius="1"/>
        </StackPanel>
        <Border Grid.Row="1" Background="White" CornerRadius="4" Padding="15" Margin="0,0,0,5" BorderBrush="#ededed" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="300"/>
                    <ColumnDefinition Width="Auto" MinWidth="200"/>
                    <ColumnDefinition Width="*" MinWidth="300"/>
                    <ColumnDefinition Width="Auto" MinWidth="250"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#F3F4F6" CornerRadius="4" Padding="5" Visibility="{Binding Teklif.Musteri, Converter={StaticResource NullToVisibilityConverter}}" Margin="0,0,20,0">
                    <StackPanel>
                        <TextBlock Text="{Binding Teklif.Musteri.FirmaAdi}" FontWeight="Bold" FontSize="14" Foreground="#13183E" FontFamily="Segoe UI"/>
                        <TextBlock Text="{Binding Teklif.Musteri.FirmaAdresi}" FontSize="12" Foreground="#6B7280" FontFamily="Segoe UI" Margin="0,5,0,0"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Tel: " FontSize="12" Foreground="#6B7280" FontFamily="Segoe UI"/>
                            <TextBlock Text="{Binding Teklif.Musteri.FirmaTelefonu}" FontSize="12" Foreground="#6B7280" FontFamily="Segoe UI"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Teklif.Musteri.FirmaEposta}" FontSize="12" Foreground="#6B7280" FontFamily="Segoe UI"/>
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="1" Margin="0,0,20,0">
                    <TextBlock Text="Durum" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,5" Foreground="#13183E" FontFamily="Segoe UI"/>
                    <ComboBox VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Width="177" Height="35" FontSize="14" ItemsSource="{Binding Durumlar}" SelectedItem="{Binding Teklif.Durum, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Müşteri Notu" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,5" Foreground="#13183E" FontFamily="Segoe UI"/>
                    <TextBox Style="{StaticResource ModernTextBox}" Height="35" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Center" Text="{Binding Teklif.MusteriNotu, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="10,0,30,0" VerticalAlignment="Center">
                    <TextBlock Text="Teklifi Veren Personel" FontWeight="SemiBold" FontSize="14" Foreground="#13183E" Margin="0,0,0,5"/>
                    <TextBlock Text="{Binding PersonelAdiSoyadi}" FontSize="14" Foreground="#13183E" Margin="0,10,0,10"/>
                    <TextBlock Text="Para Birimi" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,5" Foreground="#13183E" FontFamily="Segoe UI"/>
                    <ComboBox VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Width="178" Height="35" FontSize="14" ItemsSource="{Binding ParaBirimiListe}" SelectedItem="{Binding SelectedCurrency, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="True"/>
                </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="2" Background="White" CornerRadius="4" Padding="15" Margin="0,10,0,15" BorderBrush="#ededed" BorderThickness="1">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Ürün Listesi" FontWeight="SemiBold" FontSize="16" Foreground="#13183E" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="Yeni Ürün Ekle" Style="{StaticResource ModernButtonStyle}" Width="120" Click="YeniUrunEkle_Click"/>
                </Grid>
                <DataGrid Style="{StaticResource ModernDataGrid}" x:Name="UrunListesi" ItemsSource="{Binding TeklifUrunler}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Ürün Kodu" Binding="{Binding UrunKodu}" Width="1.5*" HeaderStyle="{StaticResource DataGridColumnHeader}" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Açıklama" Binding="{Binding UrunAciklamasi}" Width="3*" HeaderStyle="{StaticResource DataGridColumnHeader}" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Adet" Binding="{Binding Adet, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="1*" HeaderStyle="{StaticResource DataGridColumnHeader}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Birim Fiyat" Binding="{Binding BirimFiyatText}" Width="1.5*" HeaderStyle="{StaticResource DataGridColumnHeader}" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="İndirimli Fiyat" Binding="{Binding IndirimliFiyatText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="1.5*" HeaderStyle="{StaticResource DataGridColumnHeader}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Toplam" Binding="{Binding ToplamText}" Width="1.5*" HeaderStyle="{StaticResource DataGridColumnHeader}" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" CornerRadius="4" Padding="15" BorderBrush="#ededed" BorderThickness="1">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="Toplam Fiyat: " FontWeight="SemiBold" FontSize="14" Margin="10,0" Foreground="#13183E" FontFamily="Segoe UI"/>
                    <TextBlock Text="{Binding IndirimliToplamText}" FontSize="14" Margin="5,0" Foreground="#13183E" FontFamily="Segoe UI"/>
                    <TextBlock Text="KDV Tutarı: " FontWeight="SemiBold" FontSize="14" Margin="20,0,0,0" Foreground="#13183E" FontFamily="Segoe UI"/>
                    <TextBlock Text="{Binding KdvTutariText}" FontSize="14" Margin="5,0" Foreground="#13183E" FontFamily="Segoe UI"/>
                    <TextBlock Text="Genel Toplam: " FontWeight="SemiBold" FontSize="14" Margin="20,0,0,0" Foreground="#13183E" FontFamily="Segoe UI"/>
                    <TextBlock Text="{Binding GenelToplamText}" FontSize="14" Margin="5,0" Foreground="#13183E" FontFamily="Segoe UI"/>
                </StackPanel>
            </Border>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10,0,0,0">
                <Button Content="Kaydet" Style="{StaticResource ModernButtonStyle}" Width="120" Margin="0,0,10,0" Command="{Binding KaydetCommand}"/>
                <Button Content="PDF İndir" Style="{StaticResource ModernButtonStyle}" Width="120" Command="{Binding PdfIndirCommand}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>