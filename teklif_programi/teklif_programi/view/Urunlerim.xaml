<UserControl x:Class="teklif_programi.view.Urunlerim"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1350"
             Language="tr-TR">


    <UserControl.Resources>
        <!-- Modern Buton Stili -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="#13183E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Source Sans Pro"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#4B4B4B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Hücre metin stilleri -->
        <Style x:Key="CellTextLeft" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Left"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
        </Style>

        <Style x:Key="CellTextCenter" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CellTextRight" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#ededed" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Başlık -->
            <RowDefinition Height="Auto"/>
            <!-- Arama -->
            <RowDefinition Height="*"/>
            <!-- Liste -->
            <RowDefinition Height="Auto"/>
            <!-- Alt Butonlar -->
        </Grid.RowDefinitions>

        <!-- Başlık ve Alt Çizgi -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="📦 Ürünlerim"
                       FontSize="32"
                       FontWeight="Bold"
                       FontFamily="Segoe UI"
                       Foreground="#13183E"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,5"/>
            <Border Height="2"
                    Width="220"
                    Background="#13183E"
                    HorizontalAlignment="Center"
                    CornerRadius="1"/>
        </StackPanel>

        <!-- Arama Kutusu -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
            <TextBox x:Name="txtArama" Width="400" Height="38" Margin="0,0,10,0"
                     VerticalContentAlignment="Center"
                     FontFamily="Segoe UI" FontSize="14"
                     Padding="10,0"
                     BorderBrush="#ccc" BorderThickness="1"
                     Background="White"
                     TextChanged="txtArama_TextChanged"
                     Foreground="Black"/>
        </StackPanel>

        <!-- Ürün Listesi -->
        <DataGrid x:Name="dataGridUrunler" Grid.Row="2" AutoGenerateColumns="False"
                  HeadersVisibility="Column" IsReadOnly="True"
                  Margin="0,0,0,20" RowHeight="40" ColumnHeaderHeight="45"
                  CanUserAddRows="False" FontFamily="Segoe UI" FontSize="13"
                  AlternatingRowBackground="#ededed" GridLinesVisibility="None"
                  BorderBrush="#ededed" BorderThickness="1">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="ToolTip" Value="{Binding UrunAciklamasi}"/>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Resources>
                <!-- Başlıklar -->
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="Background" Value="#13183E"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderBrush" Value="White"/>
                    <Setter Property="BorderThickness" Value="0,0,1,0"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </Style>

                <!-- Hücreler: Stretch + padding -->
                <Style TargetType="DataGridCell">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="Padding" Value="8,0,8,0"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Setter Property="Foreground" Value="Black"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>

                <!-- seçim renkleri -->
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="Transparent"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="Black"/>
            </DataGrid.Resources>

            <DataGrid.Columns>
                <!-- ÜRÜN KODU -->
                <DataGridTextColumn Header="Ürün Kodu" Binding="{Binding UrunKodu}" Width="1*"
                                    ElementStyle="{StaticResource CellTextCenter}" />

                <!-- KATEGORİ -->
                <DataGridTextColumn Header="Kategori" Binding="{Binding Kategori}" Width="2*"
                                    ElementStyle="{StaticResource CellTextLeft}" />

                <!-- AÇIKLAMA -->
                <DataGridTextColumn Header="Açıklama" Binding="{Binding UrunAciklamasi}" Width="3*"
                                    ElementStyle="{StaticResource CellTextLeft}" />

                <!-- FİYATLAR (sembollü, ortalı) -->
                <DataGridTextColumn Header="TL Birim Satış Fiyatı"
                    Binding="{Binding BirimFiyat, StringFormat={}{0:N2} ₺}" Width="2*"
                    ElementStyle="{StaticResource CellTextCenter}"
                    EditingElementStyle="{StaticResource CellTextCenter}" />

                <DataGridTextColumn Header="Dolar Birim Satış Fiyatı"
                    Binding="{Binding FiyatUSD, StringFormat={}{0:N2} $}" Width="2*"
                    ElementStyle="{StaticResource CellTextCenter}"
                    EditingElementStyle="{StaticResource CellTextCenter}" />

                <DataGridTextColumn Header="Euro Birim Satış Fiyatı"
                    Binding="{Binding FiyatEUR, StringFormat={}{0:N2} €}" Width="2*"
                    ElementStyle="{StaticResource CellTextCenter}"
                    EditingElementStyle="{StaticResource CellTextCenter}" />



                <!-- İŞLEMLER -->
                <DataGridTemplateColumn Header="İşlemler" Width="250">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="Detay" Style="{StaticResource ModernButtonStyle}"
                                        Width="70" Height="30" Margin="4,0"
                                        Click="BtnDetay_Click" Background="#1874CD"/>
                                <Button Content="Maliyet" Style="{StaticResource ModernButtonStyle}"
                                        Width="70" Height="30" Margin="4,0"
                                        Background="#27AE60" Click="BtnMaliyet_Click"/>
                                <Button Content="Sil" Style="{StaticResource ModernButtonStyle}"
                                        Width="70" Height="30" Margin="4,0"
                                        Background="#C0392B" Click="BtnUrunSil_Click"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
