<Window x:Class="teklif_programi.view.ManuelUrunEkleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Manuel Ürün Ekle"
        Width="830"
        Height="740"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#ededed">
    <Window.Resources>
        <!-- Modern Buton -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="#13183E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Source Sans Pro"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#4B4B4B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern TextBox -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#ccc"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Background="#ededed" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Başlık -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20" HorizontalAlignment="Center">
            <TextBlock Text="📦⁺ Manuel Ürün Ekle" 
                       FontSize="32" 
                       FontWeight="Bold" 
                       FontFamily="Segoe UI"
                       Foreground="#13183E" />
            <Border Height="2" Width="350" Background="#13183E" CornerRadius="1" Margin="0,8,0,0"/>
        </StackPanel>

        <!-- Form -->
        <StackPanel Grid.Row="1" Width="700" HorizontalAlignment="Center" VerticalAlignment="Top">

            <!-- Ürün Kodu / Kategori -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="Ürün Kodu" FontSize="14" Foreground="#13183E" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtUrunKodu" Style="{StaticResource ModernTextBox}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <TextBlock Text="Kategori" FontSize="14" Foreground="#13183E" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtKategori" Style="{StaticResource ModernTextBox}" />
                </StackPanel>
            </Grid>

            <!-- Açıklama (TR) -->
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="Ürün Açıklaması" FontSize="14" Foreground="#13183E" Margin="0,0,0,5"/>
                <TextBox x:Name="txtAciklamaTr"
                         Height="100"
                         FontSize="14"
                         BorderBrush="#ccc"
                         BorderThickness="1"
                         Padding="10,5"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         VerticalScrollBarVisibility="Auto"
                         TextWrapping="Wrap"
                         Background="White"/>
            </StackPanel>

            <!-- Açıklama (EN) -->
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="Ürün Açıklaması (İngilizce)" FontSize="14" Foreground="#13183E" Margin="0,0,0,5"/>
                <TextBox x:Name="txtAciklamaEn"
                         Height="100"
                         FontSize="14"
                         BorderBrush="#ccc"
                         BorderThickness="1"
                         Padding="10,5"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         VerticalScrollBarVisibility="Auto"
                         TextWrapping="Wrap"
                         Background="White"/>
            </StackPanel>

            <!-- Fiyatlar -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="Birim Satış Fiyatı (TL)" FontSize="14" Foreground="#13183E" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtFiyatTl" Style="{StaticResource ModernTextBox}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="10,0,10,0">
                    <TextBlock Text="Dolar Birim Fiyatı (USD)" FontSize="14" Foreground="#13183E" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtFiyatUsd" Style="{StaticResource ModernTextBox}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="10,0,0,0">
                    <TextBlock Text="Euro Birim Fiyatı (EUR)" FontSize="14" Foreground="#13183E" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtFiyatEur" Style="{StaticResource ModernTextBox}"/>
                </StackPanel>
            </Grid>

            <!-- Maliyet -->
            <StackPanel Margin="0,0,0,30">
                <TextBlock Text="Yurtiçi Maliyet Birim Fiyatı (TL)" FontSize="14" Foreground="#13183E" Margin="0,0,0,5"/>
                <TextBox x:Name="txtMaliyetTl" Style="{StaticResource ModernTextBox}" />
            </StackPanel>

            <!-- Butonlar -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="btnKaydet" Content="Kaydet" Width="180" Margin="0,0,40,0" Style="{StaticResource ModernButtonStyle}" Click="Kaydet_Click"/>
                <Button x:Name="btnIptal" Content="İptal" Width="180" Background="#C0392B" Style="{StaticResource ModernButtonStyle}" Click="Iptal_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
