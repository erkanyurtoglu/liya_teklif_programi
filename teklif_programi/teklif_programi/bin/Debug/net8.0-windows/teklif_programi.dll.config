<?xml version="1.0" encoding="utf-8" ?>
<!-- configuration: Uygulamanın yapılandırma ayarlarını içeren ana XML elementi -->
<configuration>
	<!-- connectionStrings: Veritabanı bağlantı dizelerini tanımlayan bölüm -->
	<connectionStrings>
		<!-- add: TeklifDb adında bir bağlantı dizesi tanımlar -->
		<add name="TeklifDb"
			 connectionString="Server=EXCALIBUR\SQLEXPRESS;Database=LiyaTeklifVeriTabani;Integrated Security=True;Encrypt=False;"
			 providerName="System.Data.SqlClient" />

	</connectionStrings>
	<appSettings>
		<!-- AdminPassword uygulamanın yönetici işlemleri için gerekli parolayı temsil eder.
                     Güvenlik amacıyla gerçek parola tercihen LIYA_APP_PASSWORD ortam değişkeni
                     üzerinden sağlanmalıdır. Bu değer yalnızca varsayılan veya geliştirme
                     amaçlı kullanılmalıdır. -->
		<add key="AdminPassword" value="CHANGEME" />
	</appSettings>
</configuration>