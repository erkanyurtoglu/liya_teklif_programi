<Window x:Class="teklif_programi.view.PersonelDetayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Personel Detay" Height="600" Width="500"
        WindowStartupLocation="CenterScreen" Background="#ededed">

    <Window.Resources>
        <!-- Tema renkleri -->
        <SolidColorBrush x:Key="AccentBrush" Color="#13183E"/>
        <SolidColorBrush x:Key="CardBg" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="LabelFg" Color="#333333"/>
        <SolidColorBrush x:Key="InputBorder" Color="#D0D5DD"/>
        <SolidColorBrush x:Key="InputBorderFocus" Color="#13183E"/>

        <!-- Kart -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.15" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Etiket -->
        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="Foreground" Value="{StaticResource LabelFg}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,6,0,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- TextBox -->
        <Style TargetType="TextBox" x:Key="InputStyle">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="MinWidth" Value="260"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd"
                                CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource InputBorderFocus}"/>
                                <Setter TargetName="bd" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Buton -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.95"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Width="440" Margin="0,20,0,20" HorizontalAlignment="Center">

                <!-- Kart -->
                <Border Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <!-- Başlık -->
                            <RowDefinition Height="Auto"/>
                            <!-- Ayraç -->
                            <RowDefinition Height="Auto"/>
                            <!-- Form -->
                        </Grid.RowDefinitions>

                        <!-- Başlık -->
                        <TextBlock Grid.Row="0"
                                   Text="Personel Detay"
                                   FontSize="26" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,12"/>

                        <Separator Grid.Row="1" Margin="0,0,0,16" Background="#E6E6E6" Height="1"/>

                        <!-- FORM: tek sütun -->
                        <StackPanel Grid.Row="2">
                            <TextBlock Text="Personel Kodu" Style="{StaticResource LabelStyle}"/>
                            <TextBox x:Name="txtPersonelKodu" Style="{StaticResource InputStyle}" IsReadOnly="True"/>

                            <TextBlock Text="Ad Soyad" Style="{StaticResource LabelStyle}"/>
                            <TextBox x:Name="txtAdSoyad" Style="{StaticResource InputStyle}"/>

                            <TextBlock Text="Pozisyon" Style="{StaticResource LabelStyle}"/>
                            <TextBox x:Name="txtPozisyon" Style="{StaticResource InputStyle}"/>

                            <TextBlock Text="Telefon" Style="{StaticResource LabelStyle}"/>
                            <TextBox x:Name="txtTelefon" Style="{StaticResource InputStyle}"/>

                            <TextBlock Text="Şifre" Style="{StaticResource LabelStyle}"/>
                            <TextBox x:Name="txtSifre" Style="{StaticResource InputStyle}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Butonlar (kartın altında) -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
                    <Button Content="Kaydet" Width="160" Margin="8,0"
                            Click="BtnPersonelKaydet_Click" Style="{StaticResource ModernButtonStyle}"/>
                    <Button Content="İptal" Width="160" Margin="8,0"
                            Background="#C0392B" Click="BtnIptal_Click" Style="{StaticResource ModernButtonStyle}"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
