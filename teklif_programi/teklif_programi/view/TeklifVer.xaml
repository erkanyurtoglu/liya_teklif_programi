<UserControl x:Class="teklif_programi.view.TeklifVer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1350">

    <UserControl.Resources>
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="#13183E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Source Sans Pro"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#4B4B4B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="SepeteEkleTemplate">
            <Button Content="Seç" 
                    Style="{StaticResource ModernButtonStyle}" 
                    Width="50" Height="30"
                    Background="#2980B9" 
                    Click="BtnSepeteEkle_Click"/>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="#ededed" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,30">
            <TextBlock Text="📝 Müşteriye Teklif Ver"
                       FontSize="32" FontWeight="Bold"
                       FontFamily="Segoe UI" Foreground="#13183E"
                       TextAlignment="Center"/>
            <Border Height="2" Width="360" Background="#13183E" CornerRadius="1" Margin="0,8,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="20,0,20,0">
                <TextBlock Text="Firma Kodu" FontWeight="SemiBold" Foreground="#13183E" Margin="0,0,0,5"/>
                <TextBox x:Name="txtFirmaKodu" Height="38" FontSize="14" Padding="10,0"
                         BorderBrush="#ccc" BorderThickness="1" Background="White"
                         TextChanged="txtFirmaKodu_TextChanged"/>
                <TextBlock Text="Firma Adı" FontWeight="SemiBold" Foreground="#13183E" Margin="0,10,0,5"/>
                <TextBlock x:Name="lblFirmaAdi" Text="-" FontSize="14" Foreground="#7F8C8D"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="20,0,20,0">
                <TextBlock Text="Ürün Kodu" FontWeight="SemiBold" Foreground="#13183E" Margin="0,0,0,5"/>
                <TextBox x:Name="txtUrunKodu" Height="38" FontSize="14" Padding="10,0"
                         BorderBrush="#ccc" BorderThickness="1" Background="White"
                         TextChanged="txtUrunKodu_TextChanged"/>
                <TextBlock Text="Ürün Adı" FontWeight="SemiBold" Foreground="#13183E" Margin="0,10,0,5"/>
                <TextBlock x:Name="lblUrunAdi" Text="-" FontSize="14" Foreground="#7F8C8D"/>
                <TextBlock Text="Birim Fiyat" FontWeight="SemiBold" Foreground="#13183E" Margin="0,10,0,5"/>
                <TextBlock x:Name="lblUrunFiyati" Text="-" FontSize="14" Foreground="#7F8C8D"/>
                <Button Content="Sepete Ekle" Style="{StaticResource ModernButtonStyle}" 
                        Width="120" Height="30" Margin="0,10,0,0" Background="#2980B9" 
                        Click="BtnSepeteEkleManuel_Click"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="421*" />
                <ColumnDefinition Width="889*" />
            </Grid.ColumnDefinitions>

            <DataGrid x:Name="dataGridUrunListesi"
                      Grid.Column="0" Margin="10"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column"
                      RowHeight="40" ColumnHeaderHeight="45"
                      AlternatingRowBackground="#ededed"
                      FontFamily="Segoe UI" FontSize="13"
                      BorderBrush="#ededed" BorderThickness="1">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Ürün Kodu" Binding="{Binding UrunKoduID}" Width="1*" />
                    <DataGridTextColumn Header="Kategori" Binding="{Binding Kategori}" Width="1*" />
                    <DataGridTextColumn Header="Açıklama" Binding="{Binding Aciklama}" Width="1.5*" />
                    <DataGridTemplateColumn Header="İşlem" Width="70" CellTemplate="{StaticResource SepeteEkleTemplate}" />
                </DataGrid.Columns>
            </DataGrid>

            <DataGrid x:Name="dataGridUrunSepeti"
                      Grid.Column="1" Margin="10"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column"
                      RowHeight="40" ColumnHeaderHeight="45"
                      AlternatingRowBackground="#ededed"
                      FontFamily="Segoe UI" FontSize="13"
                      BorderBrush="#ededed" BorderThickness="1">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Ürün Kodu" Binding="{Binding UrunKoduID}" Width="1*" />
                    <DataGridTextColumn Header="Kategori" Binding="{Binding Kategori}" Width="1*" />
                    <DataGridTextColumn Header="Açıklama" Binding="{Binding Aciklama}" Width="2*" />
                    <DataGridTemplateColumn Header="Adet" Width="1.5*" >
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="-" Width="25" Height="25" Margin="0,0,5,0" Click="BtnAdetAzalt_Click"/>
                                    <TextBox Text="{Binding Adet, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                             Width="40" HorizontalContentAlignment="Center"
                                             PreviewTextInput="AdetTextBox_PreviewTextInput"/>
                                    <Button Content="+" Width="25" Height="25" Margin="5,0,0,0" Click="BtnAdetArttir_Click"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Birim Satış Fiyatı" Binding="{Binding BirimSatisFiyati, StringFormat=C2}" Width="1.4*" />
                    <DataGridTextColumn Header="Yurtiçi Maliyet" Binding="{Binding YurticiMaliyet, StringFormat=C2}" Width="1.4*" />
                    <DataGridTextColumn Header="Satış Toplam Fiyatı" Binding="{Binding SatisToplamFiyati, StringFormat=C2}" Width="1.4*" />
                    <DataGridTextColumn Header="Toplam Fiyat" Binding="{Binding ToplamFiyat, StringFormat=C2}" Width="1.2*" />
                    <DataGridTemplateColumn Header="İşlemler" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Sil" Style="{StaticResource ModernButtonStyle}" Width="70" Height="30" Background="#C0392B" Click="BtnUrunSil_Click"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <StackPanel Grid.Row="3" HorizontalAlignment="Center" Margin="0,20,0,10">
            <Button Content="Teklif Oluştur ve PDF İndir" Width="320" Height="38" Style="{StaticResource ModernButtonStyle}" Click="BtnTeklifOlusturVePdfIndir_Click"/>
        </StackPanel>
    </Grid>
</UserControl>