<UserControl x:Class="teklif_programi.view.TeklifVer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:teklif_programi"
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="1350"
             Background="#ededed">

    <UserControl.Resources>
        <!-- Null to Visibility Converter -->
        <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>

        <!-- Modern Button Style (Firmalarım sayfasındakiyle aynı) -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="#13183E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Source Sans Pro"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#4B4B4B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Red Button for Delete -->
        <Style x:Key="RedButton" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="#C0392B"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#A93226"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern TextBox Style -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#ccc"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Modern DataGrid Style -->
        <Style x:Key="ModernDataGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#ededed"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F9FAFB"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeight" Value="40"/>
            <Setter Property="ColumnHeaderHeight" Value="45"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <!-- DataGrid Column Header Style -->
        <Style x:Key="DataGridColumnHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#13183E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="472*"/>
            <ColumnDefinition Width="183*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Başlık -->
            <RowDefinition Height="Auto"/>
            <!-- Firma Arama ve İndirim/KDV -->
            <RowDefinition Height="*"/>
            <!-- Ürün Listesi ve Sepet -->
            <RowDefinition Height="Auto"/>
            <!-- Toplamlar -->
            <RowDefinition Height="Auto"/>
            <!-- Teklifi Kaydet Butonu -->
        </Grid.RowDefinitions>

        <!-- Başlık ve Alt Çizgi -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20" Grid.ColumnSpan="2">
            <TextBlock Text="📝 Teklif Oluştur" 
                       FontSize="32" 
                       FontWeight="Bold"
                       FontFamily="Segoe UI"
                       Foreground="#13183E" 
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,5"/>
            <Border Height="2" 
                    Width="350"
                    Background="#13183E" 
                    HorizontalAlignment="Center" 
                    CornerRadius="1"/>
        </StackPanel>

        <!-- Firma Arama ve İndirim/KDV -->
        <Grid Grid.Row="1" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="491*"/>
                <ColumnDefinition Width="225*"/>
                <!-- Firma Arama -->
                <ColumnDefinition Width="Auto" MinWidth="327" />
                <!-- İndirim ve KDV -->

                <ColumnDefinition Width="Auto" MinWidth="258"/>
            </Grid.ColumnDefinitions>

            <!-- Firma Arama -->
            <!-- Firma Arama -->
            <Border Grid.Column="0" Background="White" CornerRadius="4" Margin="0,0,10,20" Padding="10" BorderBrush="#ededed" BorderThickness="1" Grid.ColumnSpan="2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Firma Adı ve İlgili Kişi E-Posta -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,10">
                        <!-- Firma Adı -->
                        <StackPanel Width="230" Margin="0,0,10,0" >
                            <TextBlock Text="Firma Adı" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,5" Foreground="#13183E" />
                            <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding FirmaArama, UpdateSourceTrigger=PropertyChanged}" Width="205" Height="35" HorizontalAlignment="Left"/>
                        </StackPanel>

                        <!-- İlgili Kişi E-Posta -->
                        <StackPanel Width="230">
                            <TextBlock Text="İlgili Kişi E-Posta" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,5" Foreground="#13183E" />
                            <TextBox x:Name="ilgiliKisiEposta" Style="{StaticResource ModernTextBox}" Text="{Binding IlgiliKisiEposta, UpdateSourceTrigger=PropertyChanged}" Width="205" Height="35" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- İlgili Kişi ve Numarası -->
                    <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                        <!-- İlgili Kişi -->
                        <StackPanel Width="230" Margin="0,0,10,0">
                            <TextBlock Text="İlgili Kişi" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,5" Foreground="#13183E" />
                            <TextBox x:Name="ilgiliKisi" Style="{StaticResource ModernTextBox}" Text="{Binding IlgiliKisi, UpdateSourceTrigger=PropertyChanged}" Width="205" Height="35" HorizontalAlignment="Left"/>
                        </StackPanel>

                        <!-- İlgili Kişi Numarası -->
                        <StackPanel Width="230">
                            <TextBlock Text="İlgili Kişi Numarası" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,5" Foreground="#13183E" />
                            <TextBox x:Name="ilgiliKisiNumarasi" Style="{StaticResource ModernTextBox}" Text="{Binding IlgiliKisiNumarasi, UpdateSourceTrigger=PropertyChanged}" Width="205" Height="35" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Firma Bilgisi Kutusu -->
                    <Border Grid.Row="0" Grid.RowSpan="2" Background="#F3F4F6" CornerRadius="4"
                Visibility="{Binding FirmaBilgisi, Converter={StaticResource NullToVisibilityConverter}}"
                Padding="10" Margin="475,0,0,0">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top">
                            <TextBlock Text="{Binding FirmaBilgisi.FirmaAdi}" FontWeight="Bold" FontSize="14" Foreground="#13183E" HorizontalAlignment="Center" TextDecorations="Underline"/>
                            <TextBlock Text="{Binding FirmaBilgisi.FirmaAdresi}" FontSize="12" Foreground="Black" Margin="0,15,0,0"/>
                            <TextBlock Text="{Binding FirmaBilgisi.FirmaTelefonu}" FontSize="12" Foreground="Black" Margin="0,5,0,0"/>
                            <TextBlock Text="{Binding FirmaBilgisi.FirmaEposta}" FontSize="12" Foreground="Black" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>


            <!-- İndirim ve KDV -->
            <Border Grid.Column="2" Background="White" CornerRadius="4" Padding="15" Margin="10,0,0,20" BorderBrush="#ededed" BorderThickness="1">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="İndirim ve KDV" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10" Foreground="#13183E" FontFamily="Segoe UI" HorizontalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal">
                        <Border Background="White" CornerRadius="4" Padding="10" Margin="0,0,10,0" BorderBrush="#ededed" BorderThickness="1">
                            <StackPanel Width="120">
                                <TextBlock Text="Genel İndirim (%)" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,5" Foreground="#13183E" FontFamily="Segoe UI"/>
                                <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding GenelIndirimOrani, UpdateSourceTrigger=PropertyChanged}" PreviewTextInput="OnlyAllowNumbers"/>
                            </StackPanel>
                        </Border>
                        <Border Background="White" CornerRadius="4" Padding="10" BorderBrush="#ededed" BorderThickness="1">
                            <StackPanel Width="120">
                                <TextBlock Text="KDV Oranı (%)" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,5" Foreground="#13183E" FontFamily="Segoe UI"/>
                                <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding KdvOrani, UpdateSourceTrigger=PropertyChanged}" PreviewTextInput="OnlyAllowNumbers"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Para Birimi Seçimi -->
            <Border Grid.Column="3" Background="White" CornerRadius="4" Padding="5" Margin="20,110,0,20" BorderBrush="#ededed" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Para Birimi" FontWeight="SemiBold" FontSize="13" Margin="0,0,10,0" Foreground="#13183E" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                    <ComboBox ItemsSource="{Binding ParaBirimiListe}"
                  SelectedItem="{Binding SelectedCurrency, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  Width="135" Height="27" FontSize="14"
                  VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                  Margin="0,0,0,0"/>
                </StackPanel>
            </Border>

            <!-- Döviz Kurları Kutusu -->
            <Border Grid.Column="3" Background="White" CornerRadius="4" Margin="20,0,0,90" BorderBrush="#ededed" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Döviz Kurları" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,5" Foreground="#13183E" FontFamily="Segoe UI" HorizontalAlignment="Center"/>
                    <UniformGrid Columns="3" Margin="0,0,0,5 ">
                        <TextBlock Text="Kur" FontWeight="Bold" FontSize="12" Foreground="#13183E" Padding="25,0,0,0"/>
                        <TextBlock Text="Alış" FontWeight="Bold" FontSize="12" Foreground="#13183E" Padding="25,0,0,0"/>
                        <TextBlock Text="Satış" FontWeight="Bold" FontSize="12" Foreground="#13183E" Padding="15,0,0,0"/>
                    </UniformGrid>
                    <ItemsControl ItemsSource="{Binding DovizKurlari}" Padding="25,0,0,0" >
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <UniformGrid Columns="3" Margin="0,2">
                                    <TextBlock Text="{Binding DovizCinsi}" FontSize="12" Foreground="#333"/>
                                    <TextBlock Text="{Binding Alis}" FontSize="12" Foreground="#333"/>
                                    <TextBlock Text="{Binding Satis}" FontSize="12" Foreground="#333"/>
                                </UniformGrid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Ürün Listesi ve Sepet -->
        <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,173,0,0" Grid.RowSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="523*"/>
                <ColumnDefinition Width="Auto" MinWidth="10"/>
                <ColumnDefinition Width="777*"/>
            </Grid.ColumnDefinitions>

            <!-- Ürünler -->
            <Border Grid.Column="0" Background="White" CornerRadius="4" Padding="10" BorderBrush="#ededed" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Ürün Ara" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10" Foreground="#13183E" FontFamily="Segoe UI"/>
                    <TextBox Style="{StaticResource ModernTextBox}" Margin="0,0,0,10" Text="{Binding UrunArama, UpdateSourceTrigger=PropertyChanged}"/>
                    <DataGrid x:Name="dataGridUrunler" Style="{StaticResource ModernDataGrid}" 
                              ItemsSource="{Binding FiltrelenmisUrunler}" 
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Kod" Binding="{Binding UrunKodu}" Width="1*" HeaderStyle="{StaticResource DataGridColumnHeader}"/>
                            <DataGridTextColumn Header="Açıklama" Binding="{Binding UrunAciklamasi}" Width="2*" HeaderStyle="{StaticResource DataGridColumnHeader}"/>
                            <DataGridTemplateColumn Header="Seç" Width="Auto" HeaderStyle="{StaticResource DataGridColumnHeader}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Seç" Style="{StaticResource ModernButtonStyle}" Width="80" Height="36" 
                                                Command="{Binding DataContext.SepeteEkleCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- Sepet -->
            <Border Grid.Column="2" Background="White" CornerRadius="4" Padding="15" BorderBrush="#ededed" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Sepet" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10" Foreground="#13183E" FontFamily="Segoe UI"/>
                    <DataGrid x:Name="dataGridSepet" Style="{StaticResource ModernDataGrid}" ItemsSource="{Binding SecilenUrunler}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Kod" Binding="{Binding UrunKodu}" Width="1*" HeaderStyle="{StaticResource DataGridColumnHeader}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Açıklama" Binding="{Binding UrunAciklamasi}" Width="1*" HeaderStyle="{StaticResource DataGridColumnHeader}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Adet" Binding="{Binding Adet, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Width="0.5*" HeaderStyle="{StaticResource DataGridColumnHeader}"/>
                            <DataGridTextColumn Header="Birim Fiyat" Binding="{Binding BirimFiyat, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Width="1*" HeaderStyle="{StaticResource DataGridColumnHeader}"/>
                            <DataGridTextColumn Header="İndirimli Fiyat" Binding="{Binding IndirimliFiyat}" Width="1*" HeaderStyle="{StaticResource DataGridColumnHeader}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Toplam Fiyat" Binding="{Binding Toplam}" Width="1*" HeaderStyle="{StaticResource DataGridColumnHeader}" IsReadOnly="True"/>
                            <DataGridTemplateColumn Header="Sil" Width="1*" HeaderStyle="{StaticResource DataGridColumnHeader}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Sil" Style="{StaticResource RedButton}" Width="60" Height="36" 
                                                Command="{Binding DataContext.SepettenCikarCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Toplamlar -->
        <Border Grid.Row="3" Background="White" CornerRadius="4" Padding="15" Margin="0,20,17,20" BorderBrush="#ededed" BorderThickness="1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="Toplam Fiyat: " FontWeight="SemiBold" FontSize="14" Margin="10,0" Foreground="#13183E" FontFamily="Segoe UI"/>
                <TextBlock Text="{Binding ToplamFiyat}" FontSize="14" Margin="5,0" Foreground="#13183E" FontFamily="Segoe UI"/>
                <TextBlock Text="KDV Tutarı: " FontWeight="SemiBold" FontSize="14" Margin="20,0,0,0" Foreground="#13183E" FontFamily="Segoe UI"/>
                <TextBlock Text="{Binding KdvUcreti}" FontSize="14" Margin="5,0" Foreground="#13183E" FontFamily="Segoe UI"/>
                <TextBlock Text="Genel Toplam: " FontWeight="SemiBold" FontSize="14" Margin="20,0,0,0" Foreground="#13183E" FontFamily="Segoe UI"/>
                <TextBlock Text="{Binding GenelToplam}" FontSize="14" Margin="5,0" Foreground="#13183E" FontFamily="Segoe UI"/>
            </StackPanel>
        </Border>

        <!-- Teklifi Kaydet ve PDF İndir Butonu -->
        <Button Grid.Row="3" Content="Teklifi Kaydet ve PDF İndir" Style="{StaticResource ModernButtonStyle}" 
                HorizontalAlignment="Left" Margin="160,27,0,26" Width="187" 
                Command="{Binding KaydetVePdfIndirCommand}" Grid.Column="1" />
        <Button Grid.Row="3" Content="Satış Sözleşmesi" Style="{StaticResource ModernButtonStyle}" 
                HorizontalAlignment="Left" Margin="0,27,0,26" Width="147" 
                Grid.Column="1" Click="SatisSozlesmesi_Click" />

    </Grid>
</UserControl>