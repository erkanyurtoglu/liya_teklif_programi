<UserControl x:Class="teklif_programi.view.AlinanTekliflerim"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:teklif_programi"
             mc:Ignorable="d"
              d:DesignHeight="900" d:DesignWidth="1350">

    <UserControl.Resources>
        <!-- Modern TextBox Style -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#ccc"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Modern DatePicker Style -->
        <Style x:Key="ModernDatePicker" TargetType="DatePicker">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#ccc"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#ededed" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Başlık -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="📥 Alınan Teklifler"
                       FontSize="32"
                       FontWeight="Bold"
                       FontFamily="Segoe UI"
                       Foreground="#13183E"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,5"/>
            <Border Height="2"
                    Width="350"
                    Background="#13183E"
                    HorizontalAlignment="Center"
                    CornerRadius="1"/>
        </StackPanel>

        <!-- Arama ve Filtreleme -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center"
                    Margin="0,0,0,20" VerticalAlignment="Center">
            <TextBox x:Name="txtArama" Width="400" Margin="0,0,10,0"
                     Style="{StaticResource ModernTextBox}"
                     Text="{Binding TeklifArama, UpdateSourceTrigger=PropertyChanged}" />
            <ComboBox Width="150" Margin="0,0,10,0" Height="38" FontSize="14"
                      VerticalContentAlignment="Center"
                      ItemsSource="{Binding TarihFiltreSecenekleri}"
                      SelectedItem="{Binding SecilenTarihFiltresi, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <DatePicker Width="150" Margin="0,0,10,0"
                        Style="{StaticResource ModernDatePicker}"
                        SelectedDate="{Binding BaslangicTarihi, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Visibility="{Binding BaslangicTarihiVisibility}" />
            <DatePicker Width="150"
                        Style="{StaticResource ModernDatePicker}"
                        SelectedDate="{Binding BitisTarihi, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Visibility="{Binding BitisTarihiVisibility}" />
        </StackPanel>


        <!-- Teklif Listesi -->
        <DataGrid Grid.Row="2"
                  AutoGenerateColumns="False"
                  HeadersVisibility="Column"
                  IsReadOnly="True"
                  Margin="0,0,0,20"
                  RowHeight="40"
                  ColumnHeaderHeight="45"
                  CanUserAddRows="False"
                  FontFamily="Segoe UI"
                  FontSize="13"
                  AlternatingRowBackground="#ededed"
                  GridLinesVisibility="None"
                  BorderBrush="#ededed"
                  BorderThickness="1"
                  ItemsSource="{Binding FiltrelenmisTeklifler}"
                  SelectionMode="Single">

            <DataGrid.Resources>
                <!-- Buton -->
                <Style x:Key="ModernButtonStyle" TargetType="Button">
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="Background" Value="#13183E"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Height" Value="38"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="FontFamily" Value="Source Sans Pro"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="4">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#4B4B4B"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <!-- Başlık -->
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="Background" Value="#13183E"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderBrush" Value="White"/>
                    <Setter Property="BorderThickness" Value="0,0,1,0"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </Style>

                <!-- Hücreler -->
                <Style TargetType="DataGridCell">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="Padding" Value="8,0,8,0"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Setter Property="Foreground" Value="Black"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>

                <!-- Metin stilleri -->
                <Style x:Key="CellTextLeft" TargetType="TextBlock">
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="TextAlignment" Value="Left"/>
                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                    <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
                </Style>

                <Style x:Key="CellTextCenter" TargetType="TextBlock">
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="TextAlignment" Value="Center"/>
                </Style>

                <!-- Seçim renkleri -->
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="Transparent"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="Black"/>
            </DataGrid.Resources>

            <DataGrid.Columns>
                <DataGridTextColumn Header="Teklif No" Binding="{Binding TeklifId}" Width="0.7*"
                                    ElementStyle="{StaticResource CellTextCenter}" />

                <DataGridTextColumn Header="Firma Adı" Binding="{Binding Musteri.FirmaAdi}" Width="2*"
                                    ElementStyle="{StaticResource CellTextLeft}" />

                <DataGridTextColumn Header="Tarih" Binding="{Binding OlusturmaTarihi, StringFormat=dd.MM.yyyy}" Width="1*"
                                    ElementStyle="{StaticResource CellTextCenter}" />

                <DataGridTextColumn Header="Planlanan Teslim Tarihi" Binding="{Binding TeslimatTarihi, StringFormat=dd.MM.yyyy}" Width="1.3*"
                                    ElementStyle="{StaticResource CellTextCenter}" />

                <DataGridTextColumn Header="Teslim Tarihi" Binding="{Binding TeslimTarihi, StringFormat=dd.MM.yyyy}" Width="1*"
                                    ElementStyle="{StaticResource CellTextCenter}" />

                <DataGridTextColumn Header="Teklifi Yapan" Binding="{Binding Personel.KullaniciAdi}" Width="1.5*"
                                    ElementStyle="{StaticResource CellTextLeft}" />

                <DataGridTextColumn Header="Durum" Binding="{Binding Durum}" Width="0.8*"
                                    ElementStyle="{StaticResource CellTextCenter}" />

                <DataGridTemplateColumn Header="İşlemler" Width="260">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="Detay"
                                        Style="{StaticResource ModernButtonStyle}"
                                        Width="70" Height="30" Margin="4,0"
                                        Command="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=DataContext.DetayGosterCommand}"
                                        CommandParameter="{Binding}"
                                        Background="#1874CD"/>
                                <Button Content="Tamamla"
                                        Style="{StaticResource ModernButtonStyle}"
                                        Width="90" Height="30" Margin="4,0"
                                        Command="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=DataContext.TamamlaCommand}"
                                        CommandParameter="{Binding}"
                                        Background="#28A745"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
