<Window x:Class="teklif_programi.view.UrunSecimWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ürün Seçimi" Height="600" Width="800"
        WindowStartupLocation="CenterScreen"
        Background="#ededed">
    <Window.Resources>
        <!-- Modern Button Style -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="#13183E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Source Sans Pro"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#4B4B4B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Modern TextBox Style -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#ccc"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <!-- Modern DataGrid Style -->
        <Style x:Key="ModernDataGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#ededed"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F9FAFB"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeight" Value="48"/>
            <Setter Property="ColumnHeaderHeight" Value="50"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <!-- DataGrid Column Header Style -->
        <Style x:Key="DataGridColumnHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#13183E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Başlık ve Arama -->
            <RowDefinition Height="*"/>
            <!-- Ürün Listesi -->
            <RowDefinition Height="Auto"/>
            <!-- Adet ve İndirimli Fiyat -->
            <RowDefinition Height="Auto"/>
            <!-- Butonlar -->
        </Grid.RowDefinitions>
        <!-- Başlık ve Arama -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="📦 Ürün Seçimi" FontSize="28" FontWeight="Bold" FontFamily="Segoe UI" Foreground="#13183E" HorizontalAlignment="Center"/>
            <Border Height="2" Width="250" Background="#13183E" HorizontalAlignment="Center" CornerRadius="1"/>
            <StackPanel Margin="0,10,0,0">
                <TextBlock Text="Ürün Ara" FontWeight="SemiBold" FontSize="14" Foreground="#13183E" Margin="0,0,0,5"/>
                <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding AramaMetni, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </StackPanel>
        <!-- Ürün Listesi -->
        <Border Grid.Row="1" Background="White" CornerRadius="4" Padding="10" BorderBrush="#ededed" BorderThickness="1">
            <DataGrid Style="{StaticResource ModernDataGrid}" ItemsSource="{Binding FiltrelenmisUrunler}" SelectedItem="{Binding SecilenUrun, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="ToolTip" Value="{Binding UrunAciklamasi}"/>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Ürün Kodu" Binding="{Binding UrunKodu}" Width="1.5*" HeaderStyle="{StaticResource DataGridColumnHeader}" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Açıklama" Binding="{Binding UrunAciklamasi}" Width="3*" HeaderStyle="{StaticResource DataGridColumnHeader}" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Birim Fiyat" Binding="{Binding BirimFiyat, StringFormat=C2}" Width="1.5*" HeaderStyle="{StaticResource DataGridColumnHeader}" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <!-- Adet ve İndirimli Fiyat -->
        <Border Grid.Row="2" Background="White" CornerRadius="4" Padding="10" BorderBrush="#ededed" BorderThickness="1" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Adet" FontWeight="SemiBold" FontSize="14" Foreground="#13183E" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox Grid.Column="1" Style="{StaticResource ModernTextBox}" Text="{Binding YeniUrunAdet, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PreviewTextInput="OnlyAllowNumbers" Margin="0,0,20,0"/>
                <TextBlock Grid.Column="2" Text="İndirimli Fiyat" FontWeight="SemiBold" FontSize="14" Foreground="#13183E" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox Grid.Column="3" Style="{StaticResource ModernTextBox}" Text="{Binding YeniUrunIndirimliFiyat, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PreviewTextInput="OnlyAllowNumbers"/>
            </Grid>
        </Border>
        <!-- Butonlar -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Ekle" Style="{StaticResource ModernButtonStyle}" Width="120" Margin="0,0,10,0" Command="{Binding UrunEkleOnayCommand}"/>
            <Button Content="İptal" Style="{StaticResource ModernButtonStyle}" Width="120" Command="{Binding IptalCommand}"/>
        </StackPanel>
    </Grid>
</Window>