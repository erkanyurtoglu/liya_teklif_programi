<UserControl x:Class="teklif_programi.view.Firmalarim"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1350">

    <UserControl.Resources>
        <!-- Modern Buton Stili -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="#13183E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Source Sans Pro"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#4B4B4B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Hücre metin stilleri -->
        <Style x:Key="CellTextLeft" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Left"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
        </Style>

        <Style x:Key="CellTextCenter" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#ededed" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Başlık -->
            <RowDefinition Height="Auto"/>
            <!-- Arama -->
            <RowDefinition Height="*"/>
            <!-- Liste -->
            <RowDefinition Height="Auto"/>
            <!-- Alt Butonlar -->
        </Grid.RowDefinitions>

        <!-- Başlık -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="🏢 Müşteri Firmalarım"
                       FontSize="32"
                       FontWeight="Bold"
                       FontFamily="Segoe UI"
                       Foreground="#13183E"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,5"/>
            <Border Height="2" Width="350" Background="#13183E"
                    HorizontalAlignment="Center" CornerRadius="1"/>
        </StackPanel>

        <!-- Arama Kutusu -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
            <TextBox x:Name="txtArama" Width="400" Height="38" FontSize="14" Padding="10,0"
                     VerticalContentAlignment="Center" BorderBrush="#ccc" BorderThickness="1"
                     Background="White" Foreground="Black" TextChanged="txtArama_TextChanged"/>
        </StackPanel>

        <!-- Firma Listesi -->
        <DataGrid x:Name="dgFirmalar" Grid.Row="2" AutoGenerateColumns="False"
                  HeadersVisibility="Column" IsReadOnly="True"
                  Margin="0,0,0,20" RowHeight="40" ColumnHeaderHeight="45"
                  CanUserAddRows="False" FontFamily="Segoe UI" FontSize="13"
                  AlternatingRowBackground="#ededed" GridLinesVisibility="None"
                  BorderBrush="#ededed" BorderThickness="1">

            <DataGrid.Resources>
                <!-- Başlıklar -->
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="Background" Value="#13183E"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderBrush" Value="White"/>
                    <Setter Property="BorderThickness" Value="0,0,1,0"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </Style>

                <!-- Hücreler: Stretch + padding -->
                <Style TargetType="DataGridCell">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="Padding" Value="8,0,8,0"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Setter Property="Foreground" Value="Black"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>

                <!-- (İsteğe bağlı) Seçim renkleri -->
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="Transparent"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="Black"/>
            </DataGrid.Resources>

            <DataGrid.Columns>
                <!-- KOD -->
                <DataGridTextColumn Header="Firma Kodu" Binding="{Binding MusteriId}" Width="0.7*"
                                    ElementStyle="{StaticResource CellTextCenter}" />

                <!-- FİRMA ADI -->
                <DataGridTextColumn Header="Firma Adı" Binding="{Binding FirmaAdi}" Width="2*"
                                    ElementStyle="{StaticResource CellTextLeft}" />

                <!-- ADRES -->
                <DataGridTextColumn Header="Adres" Binding="{Binding FirmaAdresi}" Width="3*"
                                    ElementStyle="{StaticResource CellTextLeft}" />

                <!-- TELEFON -->
                <DataGridTextColumn Header="Telefon" Binding="{Binding FirmaTelefonu}" Width="2*"
                                    ElementStyle="{StaticResource CellTextCenter}" />

                <!-- EMAIL -->
                <DataGridTextColumn Header="Email" Binding="{Binding FirmaEposta}" Width="2*"
                                    ElementStyle="{StaticResource CellTextLeft}" />

                <!-- İŞLEMLER -->
                <DataGridTemplateColumn Header="İşlemler" Width="170">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="Detay" Style="{StaticResource ModernButtonStyle}"
                                        Width="70" Height="30" Margin="4,0"
                                        Click="BtnDetay_Click" Background="#1874CD"/>
                                <Button Content="Sil" Style="{StaticResource ModernButtonStyle}"
                                        Width="70" Height="30" Margin="4,0"
                                        Background="#C0392B" Click="BtnSil_Click"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
