<Window x:Class="teklif_programi.view.FirmaDetayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Firma Detay" Height="770" Width="700" WindowStartupLocation="CenterScreen" Background="#ededed">

    <Window.Resources>
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="#13183E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Source Sans Pro"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#4B4B4B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Grid.Row="1"  Width="636" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0" Height="740">
        <Grid Background="#ededed" Width="640" >
            <StackPanel Width="600" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0">
                <TextBlock Text="🏢 Firma Detayı" FontSize="30" FontWeight="Bold" Foreground="#13183E" Margin="0,0,0,20" HorizontalAlignment="Center"/>

                <TextBlock Text="Firma Adı" Margin="0,0,0,5"/>
                <TextBox x:Name="txtFirmaAdi" Height="35" Margin="0,0,0,15"/>

                <TextBlock Text="Adres" Margin="0,0,0,5"/>
                <TextBox x:Name="txtAdres" Height="35" Margin="0,0,0,15"/>

                <TextBlock Text="Telefon" Margin="0,0,0,5"/>
                <TextBox x:Name="txtTelefon" Height="35" Margin="0,0,0,15"/>

                <TextBlock Text="E-posta" Margin="0,0,0,5"/>
                <TextBox x:Name="txtEmail" Height="35" Margin="0,0,0,20"/>

                <TextBlock Text="Vergi Dairesi" Margin="0,0,0,5"/>
                <TextBox x:Name="txtVergiDairesi" Height="35" Margin="0,0,0,20"/>

                <TextBlock Text="Vergi Numarası" Margin="0,0,0,5"/>
                <TextBox x:Name="txtVergiNumarasi" Height="35" Margin="0,0,0,20"/>

                <TextBlock Text="İlgili Kişi" Margin="0,0,0,5"/>
                <TextBox x:Name="txtilgiliKisi" Height="35" Margin="0,0,0,20"/>

                <TextBlock Text="İlgili Kişi Telefon" Margin="0,0,0,5"/>
                <TextBox x:Name="txtilgiliKisiTelefon" Height="35" Margin="0,0,0,20"/>


                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <Button Content="Kaydet" Width="150" Margin="10,0" Click="BtnKaydet_Click" Style="{StaticResource ModernButtonStyle}"/>
                    <Button Content="İptal" Width="150" Margin="10,0" Background="#C0392B" Click="BtnIptal_Click" Style="{StaticResource ModernButtonStyle}"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </StackPanel>

</Window>
