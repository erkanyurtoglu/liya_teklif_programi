<Window x:Class="teklif_programi.view.UrunMaliyetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ürün Maliyetleri" Height="560" Width="720"
        WindowStartupLocation="CenterScreen" Background="#ededed">

    <Window.Resources>
        <!-- Tema -->
        <SolidColorBrush x:Key="AccentBrush" Color="#13183E"/>
        <SolidColorBrush x:Key="CardBg" Color="#FFFFFFFF"/>

        <!-- Kart -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.15" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Buton -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="#13183E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#4B4B4B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Hücre metin stilleri -->
        <Style x:Key="CellTextLeft" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Left"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
        </Style>
        <Style x:Key="CellTextCenter" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CellTextRight" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>

        <!-- DataGrid genel stil (Urunlerim ile uyumlu) -->
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="IsReadOnly" Value="False"/>
            <Setter Property="RowHeight" Value="40"/>
            <Setter Property="ColumnHeaderHeight" Value="45"/>
            <Setter Property="AlternatingRowBackground" Value="#ededed"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="BorderBrush" Value="#ededed"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- Sütun başlıkları -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#13183E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="White"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- Hücre -->
        <Style TargetType="DataGridCell">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,0,8,0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="Foreground" Value="Black"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Seçim renkleri (nötr) -->
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="Transparent"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="Black"/>

        <!-- Düzenleme TextBox’ı sağa hizalı -->
        <Style x:Key="EditRightTextBox" TargetType="TextBox">
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,0,6,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Width="680" Margin="0,20" HorizontalAlignment="Center">

                <!-- Kart -->
                <Border Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <!-- Başlık -->
                            <RowDefinition Height="Auto"/>
                            <!-- Ayraç -->
                            <RowDefinition Height="*"/>
                            <!-- Grid -->
                            <RowDefinition Height="Auto"/>
                            <!-- Toplam -->
                        </Grid.RowDefinitions>

                        <!-- Başlık -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Text="📒 Ürün Maliyetleri"
                                       FontSize="26" FontWeight="Bold"
                                       FontFamily="Segoe UI"
                                       Foreground="#13183E"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,6"/>
                            <Border Height="2" Width="220" Background="#13183E"
                                    HorizontalAlignment="Center" CornerRadius="1"/>
                        </StackPanel>

                        <Separator Grid.Row="1" Margin="0,10,0,14" Background="#E6E6E6" Height="1"/>

                        <!-- Maliyet Kalemleri -->
                        <DataGrid x:Name="dataGridMasraflar" Grid.Row="2"
                                  CanUserAddRows="True" CanUserDeleteRows="True"
                                  Margin="0,0,0,12">
                            <DataGrid.Columns>
                                <!-- Açıklama -->
                                <DataGridTextColumn Header="Açıklama" Width="3*"
                                                    Binding="{Binding Aciklama, UpdateSourceTrigger=PropertyChanged}"
                                                    ElementStyle="{StaticResource CellTextLeft}"/>

                                <!-- Tutar: görüntü formatlı, edit sağa hizalı -->
                                <DataGridTemplateColumn Header="Tutar" Width="2*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Tutar, StringFormat={}{0:N2} ₺}"
                                                       Style="{StaticResource CellTextRight}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Tutar, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                             FontFamily="Segoe UI"
                                             FontSize="14"
                                             Height="34"
                                             Padding="8,0"
                                             VerticalContentAlignment="Center"
                                             HorizontalContentAlignment="Right"
                                             BorderBrush="#13183E"
                                             BorderThickness="1.2"
                                             PreviewTextInput="OnlyAllowNumbers"
                                             DataObject.Pasting="Currency_Pasting"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Toplam -->
                        <Border Grid.Row="3" Background="#FAFAFA" CornerRadius="8"
                                Padding="12" BorderBrush="#EFEFEF" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <TextBlock Text="Toplam Maliyet:" FontWeight="Bold" FontSize="14"
                                    Foreground="#333" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock x:Name="txtToplamMaliyet"
                                    FontSize="16" FontWeight="Bold"
                                    Foreground="#13183E"
                                    VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                    </Grid>
                </Border>

                <!-- Alt Butonlar -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                    <Button Content="Kaydet" Width="160" Margin="8,0"
                            Style="{StaticResource ModernButtonStyle}"
                            Click="BtnKaydet_Click"/>
                    <Button Content="İptal" Width="160" Margin="8,0"
                            Background="#C0392B"
                            Style="{StaticResource ModernButtonStyle}"
                            Click="BtnIptal_Click"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
