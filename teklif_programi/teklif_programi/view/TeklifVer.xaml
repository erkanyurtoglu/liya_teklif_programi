<UserControl x:Class="teklif_programi.view.TeklifVer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:teklif_programi"
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="1350"
             Background="#F5F7FA">

    <UserControl.Resources>
        <!-- Null to Visibility Converter -->
        <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>

        <!-- Modern TextBox Style -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Button Style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2563EB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#A3BFFA"/>
                                <Setter Property="Foreground" Value="#E5E7EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Red Button for Delete -->
        <Style x:Key="RedButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#EF4444"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#DC2626"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#B91C1C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern DataGrid Style -->
        <Style x:Key="ModernDataGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F9FAFB"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E5E7EB"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeight" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <!-- DataGrid Column Header Style -->
        <Style x:Key="DataGridColumnHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#E5E7EB"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Firma Arama -->
        <Border Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,20" BorderBrush="#E5E7EB" BorderThickness="1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                <StackPanel Width="350" Margin="0,0,20,0">
                    <TextBlock Text="Firma Kodu veya Adı" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,5" Foreground="#1F2937"/>
                    <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding FirmaArama, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <Border Background="#F3F4F6" CornerRadius="6" Padding="10" Visibility="{Binding FirmaBilgisi, Converter={StaticResource NullToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="{Binding FirmaBilgisi.firma_adi}" FontWeight="Bold" FontSize="14" Foreground="#1F2937"/>
                        <TextBlock Text="{Binding FirmaBilgisi.firma_adresi}" FontSize="12" Foreground="#6B7280"/>
                        <TextBlock Text="{Binding FirmaBilgisi.firma_telefonu}" FontSize="12" Foreground="#6B7280"/>
                        <TextBlock Text="{Binding FirmaBilgisi.firma_email}" FontSize="12" Foreground="#6B7280"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- İndirim ve KDV -->
        <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,0,0,20">
            <Border Background="White" CornerRadius="8" Padding="15" Margin="0,0,20,0">
                <StackPanel Width="150">
                    <TextBlock Text="Genel İndirim (%)" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,5" Foreground="#1F2937"/>
                    <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding GenelIndirimOrani, UpdateSourceTrigger=PropertyChanged}" PreviewTextInput="OnlyAllowNumbers"/>
                </StackPanel>
            </Border>
            <Border Background="White" CornerRadius="8" Padding="15">
                <StackPanel Width="150">
                    <TextBlock Text="KDV Oranı (%)" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,5" Foreground="#1F2937"/>
                    <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding KdvOrani, UpdateSourceTrigger=PropertyChanged}" PreviewTextInput="OnlyAllowNumbers"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Ürün Listesi ve Sepet -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Ürünler -->
            <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="15" Margin="0,0,20,0" BorderBrush="#E5E7EB" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Ürün Ara" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10" Foreground="#1F2937"/>
                    <TextBox Style="{StaticResource ModernTextBox}" Margin="0,0,0,10" Text="{Binding UrunArama, UpdateSourceTrigger=PropertyChanged}"/>
                    <DataGrid x:Name="dataGridUrunler" Style="{StaticResource ModernDataGrid}" ItemsSource="{Binding FiltrelenmisUrunler}" SelectedItem="{Binding SeciliUrun}" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Kod" Binding="{Binding urun_kodu}" Width="1*" HeaderStyle="{StaticResource DataGridColumnHeader}"/>
                            <DataGridTextColumn Header="Açıklama" Binding="{Binding urun_aciklamasi}" Width="2*" HeaderStyle="{StaticResource DataGridColumnHeader}"/>
                            <DataGridTextColumn Header="Fiyat" Binding="{Binding birim_fiyat, StringFormat=C2}" Width="1*" HeaderStyle="{StaticResource DataGridColumnHeader}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- Sepete Ekle Butonu -->
            <Button Content="→" Grid.Column="1" Style="{StaticResource ModernButton}" Width="50" Height="50" VerticalAlignment="Center" Command="{Binding SepeteEkleCommand}" IsEnabled="{Binding SeciliUrun, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Inverse}"/>

            <!-- Sepet -->
            <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="15" BorderBrush="#E5E7EB" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Sepet" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10" Foreground="#1F2937"/>
                    <DataGrid x:Name="dataGridSepet" Style="{StaticResource ModernDataGrid}" ItemsSource="{Binding SecilenUrunler}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Kod" Binding="{Binding urun_kodu}" Width="1*" HeaderStyle="{StaticResource DataGridColumnHeader}"/>
                            <DataGridTemplateColumn Header="Adet" Width="1*" HeaderStyle="{StaticResource DataGridColumnHeader}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding adet, UpdateSourceTrigger=PropertyChanged}" Width="60" Style="{StaticResource ModernTextBox}" PreviewTextInput="OnlyAllowNumbers"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="İnd. Fiyat" Binding="{Binding indirimli_fiyat, StringFormat=C2}" Width="1*" HeaderStyle="{StaticResource DataGridColumnHeader}"/>
                            <DataGridTextColumn Header="Toplam" Binding="{Binding toplam, StringFormat=C2}" Width="1*" HeaderStyle="{StaticResource DataGridColumnHeader}"/>
                            <DataGridTemplateColumn Header="Eylem" Width="Auto" HeaderStyle="{StaticResource DataGridColumnHeader}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="+" Style="{StaticResource ModernButton}" Width="30" Margin="0,0,5,0" Command="{Binding DataContext.AdetArttirCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                                            <Button Content="-" Style="{StaticResource ModernButton}" Width="30" Margin="0,0,5,0" Command="{Binding DataContext.AdetAzaltCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                                            <Button Content="Sil" Style="{StaticResource RedButton}" Width="50" Command="{Binding DataContext.SepettenCikarCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Toplamlar -->
        <Border Grid.Row="3" Background="White" CornerRadius="8" Padding="15" Margin="0,20,0,20" BorderBrush="#E5E7EB" BorderThickness="1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="Toplam Fiyat: " FontWeight="SemiBold" FontSize="14" Margin="10,0" Foreground="#1F2937"/>
                <TextBlock Text="{Binding ToplamFiyat, StringFormat=C2}" FontSize="14" Margin="5,0" Foreground="#1F2937"/>
                <TextBlock Text="KDV Tutarı: " FontWeight="SemiBold" FontSize="14" Margin="20,0,0,0" Foreground="#1F2937"/>
                <TextBlock Text="{Binding KdvUcreti, StringFormat=C2}" FontSize="14" Margin="5,0" Foreground="#1F2937"/>
                <TextBlock Text="Genel Toplam: " FontWeight="SemiBold" FontSize="14" Margin="20,0,0,0" Foreground="#1F2937"/>
                <TextBlock Text="{Binding GenelToplam, StringFormat=C2}" FontSize="14" Margin="5,0" Foreground="#1F2937"/>
            </StackPanel>
        </Border>

        <!-- Teklifi Kaydet ve PDF İndir Butonu -->
        <Button Content="Teklifi Kaydet ve PDF İndir" Grid.Row="4" Style="{StaticResource ModernButton}" HorizontalAlignment="Right" Margin="0,0,0,0" 
                Command="{Binding KaydetVePdfIndirCommand}" 
                IsEnabled="{Binding CanSave, Mode=OneWay}"/>
    </Grid>
</UserControl>