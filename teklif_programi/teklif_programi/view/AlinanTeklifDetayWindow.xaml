<Window x:Class="teklif_programi.view.AlinanTeklifDetayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alınan Teklif Detay"
        Width="1500" Height="800"
        WindowStartupLocation="CenterScreen"
        Background="#ededed">
    <Window.Resources>
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="#13183E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Source Sans Pro"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#4B4B4B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#ccc"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="📦 Ürünler"
                       FontSize="32"
                       FontWeight="Bold"
                       FontFamily="Segoe UI"
                       Foreground="#13183E"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,5"/>
            <Border Height="2"
                    Width="200"
                    Background="#13183E"
                    HorizontalAlignment="Center"
                    CornerRadius="1"/>
        </StackPanel>

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Urunler}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  Margin="0,0,0,20"
                  RowHeight="40"
                  ColumnHeaderHeight="45"
                  AlternatingRowBackground="#ededed"
                  GridLinesVisibility="None"
                  BorderBrush="#ededed"
                  BorderThickness="1"
                  FontFamily="Segoe UI"
                  FontSize="13">
            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="Background" Value="#13183E"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderBrush" Value="White"/>
                    <Setter Property="BorderThickness" Value="0,0,1,0"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </Style>

                <Style TargetType="DataGridRowHeader">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Setter Property="Width" Value="0"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0"/>
                </Style>

                <Style TargetType="DataGridCell">
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Setter Property="Foreground" Value="Black"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>

                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True"/>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=AlternatingRowBackground}" Value="#ededed">
                            <Setter Property="Background" Value="#ededed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=AlternatingRowBackground}" Value="#f5f5f5">
                            <Setter Property="Background" Value="#f5f5f5"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>

                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="Transparent"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="Black"/>
            </DataGrid.Resources>

            <DataGrid.Columns>
                <DataGridTextColumn Header="Kod" Binding="{Binding Urun.UrunKodu}" IsReadOnly="True" Width="0.7*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="TextAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Açıklama" Binding="{Binding Urun.UrunAciklamasi}" IsReadOnly="True" Width="2.2*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="TextAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Adet" Binding="{Binding Adet}" IsReadOnly="True" Width="0.6*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="TextAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Birim Maliyet" Binding="{Binding MaliyetFiyatText}" IsReadOnly="True" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="TextAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Birim Satış Fiyatı" Binding="{Binding BirimFiyatText}" IsReadOnly="True" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="TextAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="İndirimli Birim Satış Fiyatı" Binding="{Binding IndirimliBirimFiyatText}" IsReadOnly="True" Width="1.5*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="TextAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridCheckBoxColumn Header="Tamamlandı" Binding="{Binding Tamamlandi, Mode=TwoWay}" Width="0.6*">
                    <DataGridCheckBoxColumn.ElementStyle>
                        <Style TargetType="CheckBox">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridCheckBoxColumn.ElementStyle>
                    <DataGridCheckBoxColumn.EditingElementStyle>
                        <Style TargetType="CheckBox">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridCheckBoxColumn.EditingElementStyle>
                </DataGridCheckBoxColumn>

                <DataGridTemplateColumn Header="Üretim Notu" Width="2.5*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding UretimNotu, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBox}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="4" Padding="15" BorderBrush="#ededed" BorderThickness="1" Margin="0,0,10,0">
                <Grid Margin="0,0,451,0">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="0" Margin="10,5" HorizontalAlignment="Center">
                        <TextBlock Text="Toplam Maliyet: " FontWeight="SemiBold" FontSize="14" Foreground="#13183E" FontFamily="Segoe UI"/>
                        <TextBlock Text="{Binding ToplamMaliyetText}" FontSize="14" Margin="5,0,0,0" Foreground="#13183E" FontFamily="Segoe UI"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="1" Margin="10,5" HorizontalAlignment="Center">
                        <TextBlock Text="Kar Tutarı: " FontWeight="SemiBold" FontSize="14" Foreground="#13183E" FontFamily="Segoe UI"/>
                        <TextBlock Text="{Binding KarTutariText}" FontSize="14" Margin="5,0,0,0" Foreground="#13183E" FontFamily="Segoe UI"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="2" Margin="10,5" HorizontalAlignment="Center">
                        <TextBlock Text="Kar Oranı: " FontWeight="SemiBold" FontSize="14" Foreground="#13183E" FontFamily="Segoe UI"/>
                        <TextBlock Text="{Binding KarOraniText}" FontSize="14" Margin="5,0,0,0" Foreground="#13183E" FontFamily="Segoe UI"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="23" Margin="10,5" HorizontalAlignment="Center">
                        <TextBlock Text="Paketleme Ücreti: " FontWeight="SemiBold" FontSize="14" Foreground="#13183E" FontFamily="Segoe UI"/>
                        <TextBlock Text="{Binding PaketlemeUcretiText}" FontSize="14" Margin="5,0,0,0" Foreground="#13183E" FontFamily="Segoe UI"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="0" Margin="10,5" HorizontalAlignment="Center">
                        <TextBlock Text="Toplam Fiyat: " FontWeight="SemiBold" FontSize="14" Foreground="#13183E" FontFamily="Segoe UI"/>
                        <TextBlock Text="{Binding ToplamFiyatText}" FontSize="14" Margin="5,0,0,0" Foreground="#13183E" FontFamily="Segoe UI"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="1" Margin="10,5" HorizontalAlignment="Center">
                        <TextBlock Text="KDV Tutarı: " FontWeight="SemiBold" FontSize="14" Foreground="#13183E" FontFamily="Segoe UI"/>
                        <TextBlock Text="{Binding KdvTutariText}" FontSize="14" Margin="5,0,0,0" Foreground="#13183E" FontFamily="Segoe UI"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="2" Margin="10,5" HorizontalAlignment="Center">
                        <TextBlock Text="Genel Toplam: " FontWeight="SemiBold" FontSize="14" Foreground="#13183E" FontFamily="Segoe UI"/>
                        <TextBlock Text="{Binding GenelToplamText}" FontSize="14" Margin="5,0,0,0" Foreground="#13183E" FontFamily="Segoe UI"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Button Grid.Column="1"
                    Content="Kaydet"
                    Width="120"
                    HorizontalAlignment="Right"
                    Style="{StaticResource ModernButtonStyle}"
                    Command="{Binding KaydetCommand}"/>
        </Grid>
    </Grid>
</Window>