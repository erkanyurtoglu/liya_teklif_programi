<UserControl x:Class="teklif_programi.view.Istatistikler"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="#ededed">

    <!-- =================== TEMA / KAYNAKLAR =================== -->
    <UserControl.Resources>
        <!-- Renkler -->
        <Color x:Key="PrimaryColor">#13183E</Color>
        <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
        <SolidColorBrush x:Key="CardBg" Color="White"/>
        <SolidColorBrush x:Key="Muted" Color="#6E7285"/>
        <SolidColorBrush x:Key="PageBg" Color="#ededed"/>
        <SolidColorBrush x:Key="Divider" Color="#11000000"/>

        <!-- Tipografi -->
        <Style x:Key="H1" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="32"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
        </Style>

        <Style x:Key="KpiLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <Style x:Key="KpiValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="32"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <!-- KPI kartları (hover'lı) -->
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="2" Color="#33000000" Opacity="0.5"/>
                </Setter.Value>
            </Setter>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleX="1.01" ScaleY="1.01"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- TABLO KARTI (HAREKETSİZ) -->
        <Style x:Key="StatCardStatic" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="2" Color="#33000000" Opacity="0.5"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Başlık satırı (ikonlu) -->
        <Style x:Key="CardTitleWithIcon" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- DataGrid modern görünüm -->
        <Style TargetType="DataGrid" x:Key="ModernGrid">
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#ededed"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="RowHeight" Value="34"/>
            <Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="EnableColumnVirtualization" Value="True"/>
        </Style>

        <!-- HEADER: ortalı + 14pt (dikey de ortalı) -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Satır: içerik dikey ortalı -->
        <Style TargetType="DataGridRow">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Hücreler: hem yatay hem dikey ortalı, 12pt -->
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- HÜCRE: OKUMA ve DÜZENLEME için ortalı stiller -->
        <Style x:Key="CellCenterTextBlock" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CellCenterTextBox" TargetType="TextBox">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <!-- =================== LAYOUT =================== -->
    <Grid Background="{StaticResource PageBg}" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Başlık -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,4,16">
            <TextBlock Style="{StaticResource H1}" Text="İstatistikler"/>
            <Rectangle Width="1" Height="24" Fill="{StaticResource Divider}" Margin="16,0"/>
            <TextBlock VerticalAlignment="Bottom" Margin="0,0,0,4"
                       Foreground="{StaticResource Muted}" Text="Genel görünüm • Teklif aktivitesi"/>
        </StackPanel>

        <!-- Başarı Oranları ve Top Performer -->
        <UniformGrid Grid.Row="1" Columns="3">
            <!-- Kabul Oranı -->
            <Border Style="{StaticResource StatCard}">
                <StackPanel>
                    <StackPanel Style="{StaticResource CardTitleWithIcon}">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE10B;"
                                   Foreground="{StaticResource PrimaryBrush}" Margin="0,0,8,0"/>
                        <TextBlock Style="{StaticResource KpiLabel}" Text="Kabul Oranı"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource KpiValue}" Text="{Binding KabulOrani, StringFormat={}{0:F1}%}"/>
                </StackPanel>
            </Border>

            <!-- Reddedilme Oranı -->
            <Border Style="{StaticResource StatCard}">
                <StackPanel>
                    <StackPanel Style="{StaticResource CardTitleWithIcon}">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE711;"
                                   Foreground="{StaticResource PrimaryBrush}" Margin="0,0,8,0"/>
                        <TextBlock Style="{StaticResource KpiLabel}" Text="Reddedilme Oranı"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource KpiValue}" Text="{Binding ReddedilmeOrani, StringFormat={}{0:F1}%}"/>
                </StackPanel>
            </Border>

            <!-- Top Performer -->
            <Border Style="{StaticResource StatCard}">
                <StackPanel>
                    <StackPanel Style="{StaticResource CardTitleWithIcon}">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE734;"
                                   Foreground="{StaticResource PrimaryBrush}" Margin="0,0,8,0"/>
                        <TextBlock Style="{StaticResource KpiLabel}" Text="Öne Çıkan Personel"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource KpiValue}" Text="{Binding TopPerformerAd}"/>
                    <TextBlock Style="{StaticResource KpiLabel}" Text="{Binding TopPerformerGonderilen, StringFormat={}{0} gönderilen}"/>
                    <TextBlock Style="{StaticResource KpiLabel}" Text="{Binding TopPerformerKabulEdilen, StringFormat={}{0} kabul}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- KPI Kartları -->
        <UniformGrid Grid.Row="2" Rows="2" Columns="4">
            <Border Style="{StaticResource StatCard}">
                <StackPanel>
                    <StackPanel Style="{StaticResource CardTitleWithIcon}">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE121;"
                                   Foreground="{StaticResource PrimaryBrush}" Margin="0,0,8,0"/>
                        <TextBlock Style="{StaticResource KpiLabel}" Text="Günlük Teklif"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource KpiValue}" Text="{Binding GunlukTeklif}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource StatCard}">
                <StackPanel>
                    <StackPanel Style="{StaticResource CardTitleWithIcon}">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE10C;"
                                   Foreground="{StaticResource PrimaryBrush}" Margin="0,0,8,0"/>
                        <TextBlock Style="{StaticResource KpiLabel}" Text="Haftalık Teklif"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource KpiValue}" Text="{Binding HaftalikTeklif}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource StatCard}">
                <StackPanel>
                    <StackPanel Style="{StaticResource CardTitleWithIcon}">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE787;"
                                   Foreground="{StaticResource PrimaryBrush}" Margin="0,0,8,0"/>
                        <TextBlock Style="{StaticResource KpiLabel}" Text="Aylık Teklif"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource KpiValue}" Text="{Binding AylikTeklif}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource StatCard}">
                <StackPanel>
                    <StackPanel Style="{StaticResource CardTitleWithIcon}">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE1D3;"
                                   Foreground="{StaticResource PrimaryBrush}" Margin="0,0,8,0"/>
                        <TextBlock Style="{StaticResource KpiLabel}" Text="Yıllık Teklif"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource KpiValue}" Text="{Binding YillikTeklif}"/>
                </StackPanel>
            </Border>


            <!-- Toplam Gönderilen Teklif -->
            <Border Style="{StaticResource StatCard}">
                <StackPanel>
                    <StackPanel Style="{StaticResource CardTitleWithIcon}">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE122;"
                                   Foreground="{StaticResource PrimaryBrush}" Margin="0,0,8,0"/>
                        <TextBlock Style="{StaticResource KpiLabel}" Text="Toplam Gönderilen Teklif"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource KpiValue}" Text="{Binding ToplamGonderilen}"/>
                </StackPanel>
            </Border>

            <!-- Toplam Kabul Edilen Teklif -->
            <Border Style="{StaticResource StatCard}">
                <StackPanel>
                    <StackPanel Style="{StaticResource CardTitleWithIcon}">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE10B;"
                                   Foreground="{StaticResource PrimaryBrush}" Margin="0,0,8,0"/>
                        <TextBlock Style="{StaticResource KpiLabel}" Text="Toplam Kabul Edilen Teklif"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource KpiValue}" Text="{Binding ToplamKabulEdilen}"/>
                </StackPanel>
            </Border>

            <!-- Toplam Reddedilen Teklif -->
            <Border Style="{StaticResource StatCard}">
                <StackPanel>
                    <StackPanel Style="{StaticResource CardTitleWithIcon}">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE711;"
                                   Foreground="{StaticResource PrimaryBrush}" Margin="0,0,8,0"/>
                        <TextBlock Style="{StaticResource KpiLabel}" Text="Toplam Reddedilen Teklif"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource KpiValue}" Text="{Binding ToplamReddedilen}"/>
                </StackPanel>
            </Border>

            <!-- Toplam Beklemede Teklif -->
            <Border Style="{StaticResource StatCard}">
                <StackPanel>
                    <StackPanel Style="{StaticResource CardTitleWithIcon}">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE823;"
                                   Foreground="{StaticResource PrimaryBrush}" Margin="0,0,8,0"/>
                        <TextBlock Style="{StaticResource KpiLabel}" Text="Toplam Beklemede Teklif"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource KpiValue}" Text="{Binding ToplamBeklemede}"/>
                </StackPanel>
            </Border>
        </UniformGrid>


        <!-- İnce ayraç -->
        <Rectangle Grid.Row="3" Height="1" Fill="{StaticResource Divider}" Margin="4,8"/>

        <!-- Personel Performansları -->
        <Border Grid.Row="4" Style="{StaticResource StatCardStatic}" Padding="0" Margin="0,8,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" LastChildFill="False" Margin="16,12,16,8">
                    <TextBlock Text="Personel Performansları" FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrush}" FontSize="16"/>
                    <DockPanel DockPanel.Dock="Right">
                        <Border Background="#F4F6FA" CornerRadius="8" Padding="10,6" Margin="8,0,0,0">
                            <TextBlock Foreground="{StaticResource Muted}" FontSize="12" Text="Son 30 gün"/>
                        </Border>
                    </DockPanel>
                </DockPanel>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding PersonelPerformanslari}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          Style="{StaticResource ModernGrid}"
                          ScrollViewer.CanContentScroll="True"
                          ScrollViewer.IsDeferredScrollingEnabled="True">
                    <DataGrid.Columns>

                        <!-- Personel -->
                        <DataGridTextColumn Header="Personel" Binding="{Binding Personel}" Width="3*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CellCenterTextBlock}"/>
                            </DataGridTextColumn.ElementStyle>
                            <DataGridTextColumn.EditingElementStyle>
                                <Style TargetType="TextBox" BasedOn="{StaticResource CellCenterTextBox}"/>
                            </DataGridTextColumn.EditingElementStyle>
                        </DataGridTextColumn>

                        <!-- Gönderilen -->
                        <DataGridTextColumn Header="Gönderilen" Binding="{Binding Gonderilen}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CellCenterTextBlock}"/>
                            </DataGridTextColumn.ElementStyle>
                            <DataGridTextColumn.EditingElementStyle>
                                <Style TargetType="TextBox" BasedOn="{StaticResource CellCenterTextBox}"/>
                            </DataGridTextColumn.EditingElementStyle>
                        </DataGridTextColumn>

                        <!-- Kabul Edilen -->
                        <DataGridTextColumn Header="Kabul Edilen" Binding="{Binding KabulEdilen}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CellCenterTextBlock}"/>
                            </DataGridTextColumn.ElementStyle>
                            <DataGridTextColumn.EditingElementStyle>
                                <Style TargetType="TextBox" BasedOn="{StaticResource CellCenterTextBox}"/>
                            </DataGridTextColumn.EditingElementStyle>
                        </DataGridTextColumn>

                        <!-- Reddedilen -->
                        <DataGridTextColumn Header="Reddedilen" Binding="{Binding Reddedilen}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CellCenterTextBlock}"/>
                            </DataGridTextColumn.ElementStyle>
                            <DataGridTextColumn.EditingElementStyle>
                                <Style TargetType="TextBox" BasedOn="{StaticResource CellCenterTextBox}"/>
                            </DataGridTextColumn.EditingElementStyle>
                        </DataGridTextColumn>

                        <!-- Beklemede -->
                        <DataGridTextColumn Header="Beklemede" Binding="{Binding Beklemede}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CellCenterTextBlock}"/>
                            </DataGridTextColumn.ElementStyle>
                            <DataGridTextColumn.EditingElementStyle>
                                <Style TargetType="TextBox" BasedOn="{StaticResource CellCenterTextBox}"/>
                            </DataGridTextColumn.EditingElementStyle>
                        </DataGridTextColumn>

                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
