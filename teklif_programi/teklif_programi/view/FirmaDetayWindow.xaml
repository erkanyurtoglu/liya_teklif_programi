<Window x:Class="teklif_programi.view.FirmaDetayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Firma Detay" Height="600" Width="700"
        WindowStartupLocation="CenterScreen" Background="#ededed">

    <Window.Resources>
        <!-- Tema renkleri -->
        <SolidColorBrush x:Key="AccentBrush" Color="#13183E"/>
        <SolidColorBrush x:Key="CardBg" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="LabelFg" Color="#333333"/>
        <SolidColorBrush x:Key="InputBorder" Color="#D0D5DD"/>
        <SolidColorBrush x:Key="InputBorderFocus" Color="#13183E"/>

        <!-- Kart -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.15" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Etiket -->
        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="Foreground" Value="{StaticResource LabelFg}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,6,0,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Modern TextBox -->
        <Style TargetType="TextBox" x:Key="InputStyle">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="MinWidth" Value="260"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd"
                                CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource InputBorderFocus}"/>
                                <Setter TargetName="bd" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern buton -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.95"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Width="640" Margin="0,20,0,20" HorizontalAlignment="Center">

                <!-- Kart -->
                <Border Style="{StaticResource CardStyle}" Height="448">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <!-- Başlık -->
                            <RowDefinition Height="Auto"/>
                            <!-- Ayraç -->
                            <RowDefinition Height="Auto"/>
                            <!-- Form -->
                        </Grid.RowDefinitions>

                        <!-- Başlık -->
                        <TextBlock Grid.Row="0"
                               Text="Firma Detayı"
                               FontSize="26" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,12"/>

                        <Separator Grid.Row="1" Margin="0,0,0,16" Background="#E6E6E6" Height="1"/>

                        <!-- Form -->
                        <Grid Grid.Row="2" Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Satır 1 -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,12">
                                <TextBlock Text="Firma Adı" Style="{StaticResource LabelStyle}"/>
                                <TextBox x:Name="txtFirmaAdi" Style="{StaticResource InputStyle}" TextChanged="txtFirmaAdi_TextChanged"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,12">
                                <TextBlock Text="Vergi Dairesi" Style="{StaticResource LabelStyle}"/>
                                <TextBox x:Name="txtVergiDairesi" Style="{StaticResource InputStyle}"/>
                            </StackPanel>

                            <!-- Satır 2 -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,12">
                                <TextBlock Text="Adres" Style="{StaticResource LabelStyle}"/>
                                <TextBox x:Name="txtAdres" Style="{StaticResource InputStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,12">
                                <TextBlock Text="Vergi Numarası" Style="{StaticResource LabelStyle}"/>
                                <TextBox x:Name="txtVergiNumarasi" Style="{StaticResource InputStyle}"/>
                            </StackPanel>

                            <!-- Satır 3 -->
                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,12">
                                <TextBlock Text="Telefon" Style="{StaticResource LabelStyle}"/>
                                <TextBox x:Name="txtTelefon" Style="{StaticResource InputStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="1" Margin="8,0,0,12">
                                <TextBlock Text="İlgili Kişi" Style="{StaticResource LabelStyle}"/>
                                <TextBox x:Name="txtilgiliKisi" Style="{StaticResource InputStyle}"/>
                            </StackPanel>

                            <!-- Satır 4 -->
                            <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="E-posta" Style="{StaticResource LabelStyle}"/>
                                <TextBox x:Name="txtEmail" Style="{StaticResource InputStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="3" Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="İlgili Kişi Telefon" Style="{StaticResource LabelStyle}"/>
                                <TextBox x:Name="txtilgiliKisiTelefon" Style="{StaticResource InputStyle}"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Butonlar artık kartın altında -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
                    <Button Content="Kaydet" Width="160" Margin="8,0"
                        Click="BtnKaydet_Click" Style="{StaticResource ModernButtonStyle}"/>
                    <Button Content="İptal" Width="160" Margin="8,0"
                        Background="#C0392B" Click="BtnIptal_Click" Style="{StaticResource ModernButtonStyle}"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>

</Window>
