<Window x:Class="teklif_programi.view.TeklifDetayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" 
        d:DesignHeight="700" d:DesignWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="#ededed">
    <Window.Resources>
        <!-- Modern Button Style -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="#13183E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Source Sans Pro"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#4B4B4B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern TextBox Style -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#ccc"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Modern DataGrid Style -->
        <Style x:Key="ModernDataGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#ededed"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F9FAFB"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeight" Value="40"/>
            <Setter Property="ColumnHeaderHeight" Value="45"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <!-- DataGrid Column Header Style -->
        <Style x:Key="DataGridColumnHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#13183E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="170"/>
            <RowDefinition Height="250"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Başlık -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="📑 Teklif Detayları" FontSize="32" FontWeight="Bold" FontFamily="Segoe UI" Foreground="#13183E" HorizontalAlignment="Center" Margin="0,0,0,5"/>
            <Border Height="2" Width="350" Background="#13183E" HorizontalAlignment="Center" CornerRadius="1"/>
        </StackPanel>

        <!-- Firma Bilgileri -->
        <Border Grid.Row="1" Background="White" CornerRadius="4" Padding="15" Margin="0,0,0,20" BorderBrush="#ededed" BorderThickness="1">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Firma: " FontWeight="SemiBold" FontSize="14" Foreground="#13183E" FontFamily="Segoe UI"/>
                    <TextBlock Text="{Binding Teklif.Musteri.FirmaAdi}" FontSize="14" Foreground="#13183E" FontFamily="Segoe UI"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Tarih: " FontWeight="SemiBold" FontSize="14" Foreground="#13183E" FontFamily="Segoe UI"/>
                    <TextBlock Text="{Binding Teklif.OlusturmaTarihi, StringFormat=dd.MM.yyyy}" FontSize="14" Foreground="#13183E" FontFamily="Segoe UI"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Durum ve Not -->
        <Border Grid.Row="2" Background="White" CornerRadius="4" Padding="15" BorderBrush="#ededed" BorderThickness="1">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Durum: " FontWeight="SemiBold" FontSize="14" Foreground="#13183E" FontFamily="Segoe UI"/>
                    <ComboBox Width="150" Height="38" ItemsSource="{Binding Durumlar}" SelectedItem="{Binding Teklif.Durum, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Margin="0,0,0,10">
                    <TextBlock Text="Müşteri Notu" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,5" Foreground="#13183E" FontFamily="Segoe UI"/>
                    <TextBox Style="{StaticResource ModernTextBox}" Height="60" AcceptsReturn="True" TextWrapping="Wrap" Text="{Binding Teklif.MusteriNotu, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Ürün Listesi -->
        <Border Grid.Row="3" Background="White" CornerRadius="4" Padding="15" Margin="0,20,0,20" BorderBrush="#ededed" BorderThickness="1">
            <DataGrid ItemsSource="{Binding TeklifUrunler}" AutoGenerateColumns="False" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Ürün Kodu" Binding="{Binding UrunKodu}" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Açıklama" Binding="{Binding UrunAciklamasi}" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Adet" Binding="{Binding Adet, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <DataGridTextColumn Header="Birim Fiyat" Binding="{Binding BirimFiyat, Mode=OneWay}" IsReadOnly="True"/>
                    <DataGridTextColumn Header="İndirimli Fiyat" Binding="{Binding IndirimliFiyat, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=C2}"/>
                    <DataGridTextColumn Header="Toplam" Binding="{Binding Toplam, Mode=OneWay, StringFormat=C2}" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>

        </Border>

        <!-- Toplamlar ve Butonlar -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" CornerRadius="4" Padding="15" BorderBrush="#ededed" BorderThickness="1">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="Toplam Fiyat: " FontWeight="SemiBold" FontSize="14" Margin="10,0" Foreground="#13183E" FontFamily="Segoe UI"/>
                    <TextBlock Text="{Binding TeklifToplam.IndirimliToplam, StringFormat=C2}" FontSize="14" Margin="5,0" Foreground="#13183E" FontFamily="Segoe UI"/>
                    <TextBlock Text="KDV Tutarı: " FontWeight="SemiBold" FontSize="14" Margin="20,0,0,0" Foreground="#13183E" FontFamily="Segoe UI"/>
                    <TextBlock Text="{Binding TeklifToplam.KdvTutari, StringFormat=C2}" FontSize="14" Margin="5,0" Foreground="#13183E" FontFamily="Segoe UI"/>
                    <TextBlock Text="Genel Toplam: " FontWeight="SemiBold" FontSize="14" Margin="20,0,0,0" Foreground="#13183E" FontFamily="Segoe UI"/>
                    <TextBlock Text="{Binding TeklifToplam.GenelToplam, StringFormat=C2}" FontSize="14" Margin="5,0" Foreground="#13183E" FontFamily="Segoe UI"/>
                </StackPanel>
            </Border>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10,0,0,0">
                <Button Content="Kaydet" Style="{StaticResource ModernButtonStyle}" Width="120" Margin="0,0,10,0" Command="{Binding KaydetCommand}"/>
                <Button Content="PDF İndir" Style="{StaticResource ModernButtonStyle}" Width="120" Command="{Binding PdfIndirCommand}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>