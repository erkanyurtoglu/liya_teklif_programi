<UserControl x:Class="teklif_programi.view.UrunEkle"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="800">
    <Grid Background="White" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Ürün Ekle" FontSize="24" FontWeight="Bold" Foreground="#13183E" Margin="0,0,0,20"/>
        <StackPanel Grid.Row="1" Margin="0,0,0,20">
            <TextBlock Text="Ürün Adı" FontSize="14" Foreground="#13183E" Margin="0,0,0,5"/>
            <TextBox x:Name="txtUrunAdi" Height="40" FontSize="14" BorderBrush="#13183E" BorderThickness="1" Padding="10,0" VerticalContentAlignment="Center" Background="White" Margin="0,0,0,15"/>
            <TextBlock Text="Fiyat" FontSize="14" Foreground="#13183E" Margin="0,0,0,5"/>
            <TextBox x:Name="txtFiyat" Height="40" FontSize="14" BorderBrush="#13183E" BorderThickness="1" Padding="10,0" VerticalContentAlignment="Center" Background="White" Margin="0,0,0,15"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">

            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>