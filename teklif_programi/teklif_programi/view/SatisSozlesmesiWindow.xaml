<Window x:Class="teklif_programi.view.SatisSozlesmesiWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Satış Sözleşmesi" Height="600" Width="800"
        WindowStartupLocation="CenterScreen"
        Background="#ededed">
    <Window.Resources>
        <!-- Modern Button Style (TeklifDetayWindow.xaml’dan alınmış) -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="#13183E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#4B4B4B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern RichTextBox Style (ModernTextBox’tan ilham alınmış) -->
        <Style x:Key="ModernRichTextBox" TargetType="RichTextBox">
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#ccc"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        </Style>

        <!-- Gölge efekti -->
        <DropShadowEffect x:Key="MaterialDesignShadow" ShadowDepth="2" Direction="315" Color="Black" Opacity="0.2"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Başlık -->
            <RowDefinition Height="Auto"/>
            <!-- Araç çubuğu -->
            <RowDefinition Height="*"/>
            <!-- RichTextBox -->
            <RowDefinition Height="Auto"/>
            <!-- Butonlar -->
        </Grid.RowDefinitions>

        <!-- Başlık -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="📑 Satış Sözleşmesi Düzenleyici" 
                       FontSize="32" 
                       FontWeight="Bold" 
                       FontFamily="Segoe UI" 
                       Foreground="#13183E" 
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,5"/>
            <Border Height="2" 
                    Width="500" 
                    Background="#13183E" 
                    HorizontalAlignment="Center" 
                    CornerRadius="1"/>
        </StackPanel>

        <!-- Araç Çubuğu -->
        <Border Grid.Row="1" 
                Background="White" 
                CornerRadius="4" 
                Padding="5" 
                Margin="0,0,0,10" 
                BorderBrush="#ededed" 
                BorderThickness="1"
                Effect="{StaticResource MaterialDesignShadow}">
            <ToolBar Background="Transparent" BorderThickness="0">
                <Button Content="Kalın" 
                        Command="EditingCommands.ToggleBold" 
                        ToolTip="Metni kalın yap (Ctrl+B)"
                        Style="{StaticResource ModernButtonStyle}" Width="100" Margin="10"/>
                <Button Content="İtalik" 
                        Command="EditingCommands.ToggleItalic" 
                        ToolTip="Metni italik yap (Ctrl+I)"
                        Style="{StaticResource ModernButtonStyle}" Width="100" Margin="10"/>
                <Button Content="Altı Çizili" 
                        Command="EditingCommands.ToggleUnderline" 
                        ToolTip="Metni altı çizili yap (Ctrl+U)"
                        Style="{StaticResource ModernButtonStyle}" Width="140" Margin="10"/>
                <Separator Margin="5,0"/>
                <Button Content="Madde İşareti" 
                        Command="EditingCommands.ToggleBullets" 
                        ToolTip="Madde işaretli liste ekle"
                        Style="{StaticResource ModernButtonStyle}" Width="140" Margin="10"/>
                <Button Content="Numaralı Liste" 
                        Command="EditingCommands.ToggleNumbering" 
                        ToolTip="Numaralı liste ekle"
                        Style="{StaticResource ModernButtonStyle}" Width="158"/>
            </ToolBar>
        </Border>

        <!-- RichTextBox ile düzenlenebilir sözleşme alanı -->
        <Border Grid.Row="2" 
                Background="White" 
                CornerRadius="4" 
                Padding="10" 
                Margin="0,0,0,15" 
                BorderBrush="#ededed" 
                BorderThickness="1"
                Effect="{StaticResource MaterialDesignShadow}">
            <RichTextBox x:Name="SatisSozlesmesiBox" 
                         Style="{StaticResource ModernRichTextBox}"
                         AcceptsReturn="True">
                <RichTextBox.Resources>
                    <Style TargetType="{x:Type Paragraph}">
                        <Setter Property="Margin" Value="0,5,0,5"/>
                    </Style>
                </RichTextBox.Resources>
            </RichTextBox>
        </Border>

        <!-- Butonlar -->
        <StackPanel Grid.Row="3" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right">
            <Button Content="Varsayılana Sıfırla" 
                    Width="150" 
                    Style="{StaticResource ModernButtonStyle}"
                    Click="Sifirla_Click"
                    Margin="0,0,10,0"/>
            <Button Content="Kapat" 
                    Width="120" 
                    Style="{StaticResource ModernButtonStyle}"
                    Click="Kapat_Click"/>
        </StackPanel>
    </Grid>
</Window>