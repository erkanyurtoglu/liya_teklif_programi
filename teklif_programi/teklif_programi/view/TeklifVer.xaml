<UserControl x:Class="teklif_programi.view.TeklifVer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:teklif_programi"
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="1350"
             Background="#ededed">

    <UserControl.Resources>
        <!-- Null to Visibility Converter -->
        <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>

        <!-- Modern Button Style -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="#13183E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Source Sans Pro"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#4B4B4B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Red Button for Delete -->
        <Style x:Key="RedButton" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="#C0392B"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#A93226"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern TextBox Style -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#ccc"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Modern DataGrid Style -->
        <Style x:Key="ModernDataGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#ededed"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F9FAFB"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeight" Value="40"/>
            <Setter Property="ColumnHeaderHeight" Value="45"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <!-- DataGrid Column Header Style -->
        <Style x:Key="DataGridColumnHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#13183E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CenterTextBlock" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>

        <Style x:Key="CenterTextBox" TargetType="TextBox">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="472*"/>
            <ColumnDefinition Width="183*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Başlık -->
            <RowDefinition Height="Auto"/>
            <!-- Firma Arama ve İndirim/KDV -->
            <RowDefinition Height="*"/>
            <!-- Ürün Listesi ve Sepet -->
            <RowDefinition Height="Auto"/>
            <!-- Toplamlar ve Döviz Kurları -->
            <RowDefinition Height="Auto"/>
            <!-- Teklifi Kaydet Butonu -->
        </Grid.RowDefinitions>

        <!-- Başlık ve Alt Çizgi -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10" Grid.ColumnSpan="2">
            <TextBlock Text="📝 Teklif Oluştur" 
                       FontSize="32" 
                       FontWeight="Bold"
                       FontFamily="Segoe UI"
                       Foreground="#13183E" 
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,5"/>
            <Border Height="2" Width="270" Background="#13183E" CornerRadius="1" Margin="0,-10,0,0"/>
        </StackPanel>

        <!-- Firma Arama ve İndirim/KDV -->
        <Grid Grid.ColumnSpan="2" Margin="-10,50,10,10" Grid.RowSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="287*"/>
                <ColumnDefinition Width="250*"/>
                <ColumnDefinition Width="150*"/>
                <!-- Firma Arama -->
                <!-- İndirim ve KDV -->
                <ColumnDefinition Width="150" />
            </Grid.ColumnDefinitions>

            <!-- Firma Arama -->
            <Border Grid.Column="0" Background="White" CornerRadius="4" Margin="0,0,1,20" Padding="10" BorderBrush="#ededed" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Firma Adı ve İlgili Kişi E-Posta -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,10">
                        <!-- Firma Adı -->
                        <StackPanel Width="135" Margin="0,0,10,0">
                            <TextBlock Text="Firma Adı" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,5" Foreground="#13183E"/>
                            <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding FirmaArama, UpdateSourceTrigger=PropertyChanged}" Width="130" Height="35" HorizontalAlignment="Left"/>
                        </StackPanel>

                        <!-- İlgili Kişi E-Posta -->
                        <StackPanel Width="135">
                            <TextBlock Text="İlgili Kişi E-Posta" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,5" Foreground="#13183E"/>
                            <TextBox x:Name="ilgiliKisiEposta" Style="{StaticResource ModernTextBox}" Text="{Binding IlgiliKisiEposta, UpdateSourceTrigger=PropertyChanged}" Width="130" Height="35" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- İlgili Kişi ve Numarası -->
                    <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                        <!-- İlgili Kişi -->
                        <StackPanel Width="135" Margin="0,0,10,0">
                            <TextBlock Text="İlgili Kişi" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,5" Foreground="#13183E"/>
                            <TextBox x:Name="ilgiliKisi" Style="{StaticResource ModernTextBox}" Text="{Binding IlgiliKisi, UpdateSourceTrigger=PropertyChanged}" Width="130" Height="35" HorizontalAlignment="Left"/>
                        </StackPanel>

                        <!-- İlgili Kişi Numarası -->
                        <StackPanel Width="135">
                            <TextBlock Text="İlgili Kişi Numarası" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,5" Foreground="#13183E"/>
                            <TextBox x:Name="ilgiliKisiNumarasi" Style="{StaticResource ModernTextBox}" Text="{Binding IlgiliKisiNumarasi, UpdateSourceTrigger=PropertyChanged}" Width="130" Height="35" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Firma Bilgisi Kutusu -->
                    <Border Grid.Row="0" Grid.RowSpan="2" Background="#F3F4F6" CornerRadius="4"
                            Visibility="{Binding FirmaBilgisi, Converter={StaticResource NullToVisibilityConverter}}"
                            Padding="10" Margin="294,0,0,0">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top">
                            <TextBlock Text="{Binding FirmaBilgisi.FirmaAdi}" FontWeight="Bold" FontSize="14" Foreground="#13183E" HorizontalAlignment="Center" TextDecorations="Underline"/>
                            <TextBlock Text="{Binding FirmaBilgisi.FirmaAdresi}" FontSize="12" Foreground="Black" Margin="0,15,0,0"/>
                            <TextBlock Text="{Binding FirmaBilgisi.FirmaTelefonu}" FontSize="12" Foreground="Black" Margin="0,5,0,0"/>
                            <TextBlock Text="{Binding FirmaBilgisi.FirmaEposta}" FontSize="12" Foreground="Black" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- İndirim ve KDV -->
            <Border Grid.Column="1" Background="White" CornerRadius="4" Padding="5" Margin="10,0,10,20" BorderBrush="#ededed" BorderThickness="1">
                <StackPanel Orientation="Vertical" Margin="0,0,4,0">
                    <TextBlock Text="Ücretler" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10" Foreground="#13183E" FontFamily="Segoe UI" HorizontalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" Width="366">
                        <Border Background="White" CornerRadius="4" Padding="10" Margin="0,0,10,0" BorderBrush="#ededed" BorderThickness="1">
                            <StackPanel Width="60">
                                <TextBlock Text="İndirim (%)" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,5" Foreground="#13183E" FontFamily="Segoe UI"/>
                                <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding GenelIndirimOrani, UpdateSourceTrigger=PropertyChanged}" PreviewTextInput="OnlyAllowNumbers"/>
                            </StackPanel>
                        </Border>
                        <Border Background="White" CornerRadius="4" Padding="10" BorderBrush="#ededed" BorderThickness="1">
                            <StackPanel Width="60">
                                <TextBlock Text="KDV (%)" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,5" Foreground="#13183E" FontFamily="Segoe UI"/>
                                <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding KdvOrani, UpdateSourceTrigger=PropertyChanged}" PreviewTextInput="OnlyAllowNumbers"/>
                            </StackPanel>
                        </Border>
                        <Border Background="White" CornerRadius="4" Padding="10" BorderBrush="#ededed" BorderThickness="1" Margin="10,0">
                            <StackPanel Width="60">
                                <TextBlock Text="Paketleme" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,5" Foreground="#13183E" FontFamily="Segoe UI"/>
                                <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding PaketlemeUcret, UpdateSourceTrigger=PropertyChanged}" PreviewTextInput="OnlyAllowNumbers"/>
                            </StackPanel>
                        </Border>
                        <Border Background="White" CornerRadius="4" Padding="10" BorderBrush="#ededed" BorderThickness="1" Margin="0,0">
                            <StackPanel Width="60">
                                <TextBlock Text="Taşıma" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,5" Foreground="#13183E" FontFamily="Segoe UI"/>
                                <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding TasimaUcret, UpdateSourceTrigger=PropertyChanged}" PreviewTextInput="OnlyAllowNumbers"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>


            <!-- Teslimat Bilgisi -->
            <Border Grid.Column="2" Background="White" CornerRadius="4" Padding="10" Margin="0,0,0,20" BorderBrush="#ededed" BorderThickness="1">
                <StackPanel>

                    <!-- Teslimat Şekli -->
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="Teslimat Şekli:" 
                       FontWeight="SemiBold" FontSize="13" Foreground="#13183E" Margin="0,0,0,5"/>
                        <TextBox Style="{StaticResource ModernTextBox}"
                     Text="{Binding TeslimatSekli, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True" TextWrapping="Wrap" Height="35"
                     ToolTip="Örn: Kara yolu, Hava yolu, Deniz yolu"/>
                    </StackPanel>

                    <!-- Teslimat Yeri -->
                    <StackPanel>
                        <TextBlock Text="Teslimat Yeri:" 
                       FontWeight="SemiBold" FontSize="13" Foreground="#13183E" Margin="0,0,0,5"/>
                        <TextBox Style="{StaticResource ModernTextBox}"
                     Text="{Binding TeslimatYeri, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True" TextWrapping="Wrap" Height="39"
                     ToolTip="Örn: Demirexport fabrikasına teslimat"/>
                    </StackPanel>
                </StackPanel>
            </Border>


            <!-- Dil ve Para Birimi -->
            <Border Grid.Column="3" Background="White" CornerRadius="4" Padding="10" Margin="10,0,0,20" BorderBrush="#ededed" BorderThickness="1">
                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                    <!-- Dil -->
                    <StackPanel Orientation="Vertical" Margin="0,0,0,10">
                        <TextBlock Text="Dil" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,5" Foreground="#13183E" FontFamily="Segoe UI" HorizontalAlignment="Center"/>
                        <ComboBox ItemsSource="{Binding DilListe}"
                                  SelectedItem="{Binding SelectedLanguage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Width="100" Height="27" FontSize="14"
                                  VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                    </StackPanel>

                    <!-- Para Birimi -->
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Para Birimi" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,5" Foreground="#13183E" FontFamily="Segoe UI" HorizontalAlignment="Center"/>
                        <ComboBox ItemsSource="{Binding ParaBirimiListe}"
                                  SelectedItem="{Binding SelectedCurrency, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Width="100" Height="27" FontSize="14"
                                  VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Ürün Listesi ve Sepet -->
        <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="523*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="777*"/>
            </Grid.ColumnDefinitions>

            <!-- Ürünler -->
            <Border Grid.Column="0" Background="White" CornerRadius="4" Padding="10"
        BorderBrush="#ededed" BorderThickness="1" Margin="0,-22,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Başlık -->
                        <RowDefinition Height="Auto"/>
                        <!-- Arama kutusu -->
                        <RowDefinition Height="*"/>
                        <!-- DataGrid -->
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Ürün Ara" FontWeight="SemiBold" FontSize="14"
                   Margin="0,0,0,10" Foreground="#13183E" FontFamily="Segoe UI"/>

                    <TextBox Grid.Row="1" Style="{StaticResource ModernTextBox}" Margin="0,0,0,10"
                 Text="{Binding UrunArama, UpdateSourceTrigger=PropertyChanged}"/>

                    <DataGrid Grid.Row="2" x:Name="dataGridUrunler" Style="{StaticResource ModernDataGrid}"
                  ItemsSource="{Binding FiltrelenmisUrunler}" SelectionMode="Single"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  EnableRowVirtualization="True" EnableColumnVirtualization="True">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="ToolTip" Value="{Binding UrunAciklamasi}"/>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Resources>
                            <Style TargetType="DataGridCell">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="8,0,8,0"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="Black"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="Transparent"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="Black"/>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Kod" Binding="{Binding UrunKodu}" Width="1*" HeaderStyle="{StaticResource DataGridColumnHeader}"/>
                            <DataGridTextColumn Header="Açıklama" Binding="{Binding UrunAciklamasi}" Width="2*" HeaderStyle="{StaticResource DataGridColumnHeader}"/>
                            <DataGridTemplateColumn Header="Seç" Width="Auto" HeaderStyle="{StaticResource DataGridColumnHeader}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Seç" Style="{StaticResource ModernButtonStyle}" Width="80" Height="36" Background="#1874CD"
                                    Command="{Binding DataContext.SepeteEkleCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Sepet -->
            <Border Grid.Column="2" Background="White" CornerRadius="4" Padding="15"
        BorderBrush="#ededed" BorderThickness="1" Margin="0,-22,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Başlık -->
                        <RowDefinition Height="*"/>
                        <!-- DataGrid -->
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Sepet" FontWeight="SemiBold" FontSize="14"
                   Margin="0,0,0,10" Foreground="#13183E" FontFamily="Segoe UI"/>

                    <DataGrid Grid.Row="1" x:Name="dataGridSepet" Style="{StaticResource ModernDataGrid}" 
                  ItemsSource="{Binding SecilenUrunler}"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  EnableRowVirtualization="True" EnableColumnVirtualization="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Kod" Binding="{Binding UrunKodu}" Width="1*" HeaderStyle="{StaticResource DataGridColumnHeader}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Açıklama" Binding="{Binding UrunAciklamasi, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Width="1*" HeaderStyle="{StaticResource DataGridColumnHeader}"/>
                            <DataGridTextColumn Header="Adet"
                                    Binding="{Binding Adet, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                    Width="0.7*"
                                    HeaderStyle="{StaticResource DataGridColumnHeader}"
                                    ElementStyle="{StaticResource CenterTextBlock}"
                                    EditingElementStyle="{StaticResource CenterTextBox}"/>
                            <DataGridTextColumn Header="Maliyet Fiyatı" Binding="{Binding MaliyetFiyatText}" Width="1.1*" HeaderStyle="{StaticResource DataGridColumnHeader}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Birim Fiyat" Binding="{Binding BirimFiyatText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Width="1*" HeaderStyle="{StaticResource DataGridColumnHeader}"/>
                            <DataGridTextColumn Header="İndirimli Fiyat" Binding="{Binding IndirimliFiyatText}" Width="1.2*" HeaderStyle="{StaticResource DataGridColumnHeader}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Toplam Fiyat" Binding="{Binding ToplamText}" Width="1.1*" HeaderStyle="{StaticResource DataGridColumnHeader}" IsReadOnly="True"/>
                            <DataGridTemplateColumn Header="Sil" Width="1*" HeaderStyle="{StaticResource DataGridColumnHeader}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Sil" Style="{StaticResource RedButton}" Width="60" Height="36" 
                                    Command="{Binding DataContext.SepettenCikarCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                    CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- Toplamlar ve Döviz Kurları -->
        <Grid Grid.Row="3" Grid.ColumnSpan="2" Margin="0,20,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="221"/>
                <!-- Döviz Kurları -->
                <ColumnDefinition/>
                <!-- Toplamlar -->
                <ColumnDefinition Width="Auto"/>
                <!-- Buttons -->
            </Grid.ColumnDefinitions>

            <!-- Döviz Kurları Kutusu -->
            <Border Grid.Column="0" Background="White" CornerRadius="4" Margin="0,0,10,0" BorderBrush="#ededed" BorderThickness="1" Padding="15">
                <StackPanel>
                    <TextBlock Text="Döviz Kurları" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,5" Foreground="#13183E" FontFamily="Segoe UI" HorizontalAlignment="Center"/>
                    <UniformGrid Columns="3" Margin="0,0,0,5">
                        <TextBlock Text="Kur" FontWeight="Bold" FontSize="12" Foreground="#13183E" Padding="15,0,0,0"/>
                        <TextBlock Text="Alış" FontWeight="Bold" FontSize="12" Foreground="#13183E" Padding="17,0,0,0"/>
                        <TextBlock Text="Satış" FontWeight="Bold" FontSize="12" Foreground="#13183E" Padding="13,0,0,0"/>
                    </UniformGrid>
                    <ItemsControl ItemsSource="{Binding DovizKurlari}" Padding="15,0,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <UniformGrid Columns="3" Margin="0,2">
                                    <TextBlock Text="{Binding DovizCinsi}" FontSize="12" Foreground="#333"/>
                                    <TextBlock Text="{Binding Alis}" FontSize="12" Foreground="#333"/>
                                    <TextBlock Text="{Binding Satis}" FontSize="12" Foreground="#333"/>
                                </UniformGrid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Toplamlar -->
            <Border Grid.Column="1" Background="White" CornerRadius="4" Padding="15" BorderBrush="#ededed" BorderThickness="1" Margin="0,0,37,0">
                <Grid HorizontalAlignment="Right">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="0" Margin="10,5" HorizontalAlignment="Center">
                        <TextBlock Text="Toplam Maliyet: " FontWeight="SemiBold" FontSize="14" Foreground="#13183E" FontFamily="Segoe UI"/>
                        <TextBlock Text="{Binding ToplamMaliyetText}" FontSize="14" Margin="5,0,0,0" Foreground="#13183E" FontFamily="Segoe UI"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="1" Margin="10,5" HorizontalAlignment="Center">
                        <TextBlock Text="Kar Tutarı: " FontWeight="SemiBold" FontSize="14" Foreground="#13183E" FontFamily="Segoe UI"/>
                        <TextBlock Text="{Binding KarTutariText}" FontSize="14" Margin="5,0,0,0" Foreground="#13183E" FontFamily="Segoe UI"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="2" Margin="10,5" HorizontalAlignment="Center">
                        <TextBlock Text="Kar Oranı: " FontWeight="SemiBold" FontSize="14" Foreground="#13183E" FontFamily="Segoe UI"/>
                        <TextBlock Text="{Binding KarOraniText}" FontSize="14" Margin="5,0,0,0" Foreground="#13183E" FontFamily="Segoe UI"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="0" Margin="10,5" HorizontalAlignment="Center">
                        <TextBlock Text="Toplam Fiyat: " FontWeight="SemiBold" FontSize="14" Foreground="#13183E" FontFamily="Segoe UI"/>
                        <TextBlock Text="{Binding ToplamFiyatText}" FontSize="14" Margin="5,0,0,0" Foreground="#13183E" FontFamily="Segoe UI"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="1" Margin="10,5" HorizontalAlignment="Center">
                        <TextBlock Text="KDV Tutarı: " FontWeight="SemiBold" FontSize="14" Foreground="#13183E" FontFamily="Segoe UI"/>
                        <TextBlock Text="{Binding KdvUcretiText}" FontSize="14" Margin="5,0,0,0" Foreground="#13183E" FontFamily="Segoe UI"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="2" Margin="10,5" HorizontalAlignment="Center">
                        <TextBlock Text="Genel Toplam: " FontWeight="SemiBold" FontSize="14" Foreground="#13183E" FontFamily="Segoe UI"/>
                        <TextBlock Text="{Binding GenelToplamText}" FontSize="14" Margin="5,0,0,0" Foreground="#13183E" FontFamily="Segoe UI"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Teklifi Kaydet ve PDF İndir Butonu -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,27,0,26" Width="344">
                <Button Content="Satış Sözleşmesi" Style="{StaticResource ModernButtonStyle}" 
                        Width="147" 
                        Click="SatisSozlesmesi_Click"
                        Margin="0,0,10,0"/>

